---
// One FreshBench table: a row per model and condition, a column per subject and one for all of them. Each cell is
// answers graded correct out of questions, with its 95% Wilson interval drawn to scale: the width of the interval is
// what to compare, so nothing is colored by score. A model with no run gets one "not measured" row.
import type { Row, Table } from "../build/bench.ts";
import { en } from "../strings/en.ts";

interface Props {
  table: Table;
  /** Labels the table (its id is used by aria-labelledby). */
  labelledBy: string;
  /** The tools every row's condition had, e.g. "Claude Code's read-only tools" or "No tools". */
  tools: string;
  /** Only this model's rows. */
  model?: string;
  /** Link each model name to its /bench/<model>/ page. */
  link?: boolean;
  /** Bigger type, for the share card. */
  size?: "normal" | "card";
}
const { table, labelledBy, tools, model, link = true, size = "normal" } = Astro.props;
const b = en.bench;
const rows = table.rows.filter((r) => !model || r.model === model);
const label = (column: string) => (column === "all" ? b.all : column);
// The card names the tools in its caption, so its rows say only what differs.
const condition = (r: Extract<Row, { measured: true }>) =>
  size === "card" ? [b.webSearch(r.webSearch), b.sync(r.sync)] : [tools, b.webSearch(r.webSearch), b.sync(r.sync)];
const card = size === "card";
const pct = (x: number) => b.percent(x);
// Rounded to a tenth of a percent so the drawn interval matches the printed one.
const at = (x: number) => `${Math.round(x * 1000) / 10}%`;
---

<div class:list={["scroll", size]} role="region" aria-labelledby={labelledBy} tabindex="0">
  <table aria-labelledby={labelledBy}>
    <thead>
      <tr>
        {!card && <th scope="col" class="first">{b.model}</th>}
        <th scope="col" class:list={{ first: card }}>{b.condition}</th>
        {table.columns.map((c) => <th scope="col" class:list={["num", { all: c === "all" }]}>{label(c)}</th>)}
      </tr>
    </thead>
    <tbody>
      {
        rows.map((r) => (
          <tr class:list={{ unmeasured: !r.measured }}>
            {!card && (
              <th scope="row" class="first">
                {link ? <a href={`/bench/${r.model}/`}>{r.name}</a> : r.name}
              </th>
            )}
            {r.measured ? (
              <>
                <td class:list={["cond", { first: card }]}>
                  {condition(r).map((part) => (
                    <span>{part}</span>
                  ))}
                </td>
                {table.columns.map((c) => {
                  const x = r.cells[c]!;
                  return (
                    <td class:list={["num", { all: c === "all" }]}>
                      <span class="frac">
                        {x.correct}/{x.total}
                      </span>
                      <span class="ci">
                        <span class="visually-hidden">{b.interval(pct(x.low), pct(x.high))}</span>
                        <span aria-hidden="true">{b.range(x.low, x.high)}</span>
                      </span>
                      <span class="bar" aria-hidden="true">
                        <span class="range" style={`left:${at(x.low)};width:${at(x.high - x.low)}`} />
                        <span class="point" style={`left:${at(x.total ? x.correct / x.total : 0)}`} />
                      </span>
                    </td>
                  );
                })}
              </>
            ) : (
              <td class="none" colspan={table.columns.length + 1}>
                {b.notMeasured}
              </td>
            )}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  /* The containing block for the cells' visually hidden text, so it can't widen the page. */
  .scroll {
    position: relative;
    overflow-x: auto;
    margin: 0 0 12px;
  }
  table {
    border-collapse: separate;
    border-spacing: 0;
    font-size: 14px;
    min-width: 100%;
  }
  th,
  td {
    text-align: left;
    padding: 12px 20px 12px 0;
    border-top: 1px solid var(--rule);
    vertical-align: top;
  }
  thead th {
    border-top: 0;
    padding-top: 0;
    color: var(--muted);
    font-weight: 600;
    white-space: nowrap;
  }
  /* The model column stays put while the rest scrolls sideways on a narrow screen. */
  .first {
    position: sticky;
    left: 0;
    z-index: 1;
    min-width: 9.5em;
    padding-right: 16px;
  }
  tbody .first {
    font-weight: 700;
    color: var(--ink);
  }
  .cond {
    min-width: 12em;
    color: var(--muted);
  }
  .cond span {
    display: block;
  }
  .num {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    min-width: 7.5em;
  }
  .num.all {
    padding-left: 20px;
    border-left: 1px solid var(--rule);
  }
  thead .num.all {
    border-left: 0;
  }
  .frac {
    display: block;
    font-size: 20px;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.2;
  }
  .ci {
    display: block;
    color: var(--muted);
    font-size: 13px;
  }
  /* The interval on a 0–100% scale: a line for the range, a tick at the score. */
  .bar {
    position: relative;
    display: block;
    height: 10px;
    margin-top: 6px;
    width: 100%;
    min-width: 6em;
    background: linear-gradient(var(--rule), var(--rule)) 0 50% / 100% 1px no-repeat;
  }
  .range {
    position: absolute;
    top: 3px;
    height: 4px;
    background: var(--muted);
  }
  .point {
    position: absolute;
    top: 0;
    width: 2px;
    height: 10px;
    margin-left: -1px;
    background: var(--ink);
  }
  .none {
    color: var(--muted);
  }
  .unmeasured .first {
    font-weight: 600;
  }

  .card table {
    font-size: 20px;
  }
  .card th,
  .card td {
    padding: 18px 28px 18px 0;
  }
  .card .frac {
    font-size: 34px;
  }
  .card .ci {
    font-size: 18px;
  }
  .card .bar {
    height: 14px;
    margin-top: 10px;
  }
  .card .range {
    top: 4px;
    height: 6px;
  }
  .card .point {
    height: 14px;
    width: 3px;
  }
  .card .first {
    min-width: 0;
    font-weight: 400;
  }
  .card .cond {
    min-width: 0;
  }
  /* The fixed column needs the page's color only where the table can scroll under it; on a wide screen it would
     cover the water. */
  @media (max-width: 1100px) {
    .first {
      background: var(--paper);
    }
  }
</style>
