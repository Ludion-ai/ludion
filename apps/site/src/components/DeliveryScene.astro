---
import BrandMark from "./BrandMark.astro";
import { localPath, strings, type Lang } from "../strings/index.ts";
const { lang = "en" } = Astro.props as { lang?: Lang };
const t = strings[lang];
const iso = t.home.isolate;
// Stage labels for the existing delivery animation. This page runs nothing.
const s = {
  label: iso.bar,
  choose: iso.stagesLabel,
  context: iso.context,
  reference: iso.reference,
  inline: iso.inline,
  illustration: iso.scope,
  replay: iso.replay,
  scope: iso.scope,
  limits: iso.limits,
  unavailable: iso.unavailable,
  setup: t.nav.start,
};
const routes = [
  { id: "install", name: iso.install, file: iso.installFile, note: iso.installDetail },
  { id: "run", name: iso.run, file: iso.runFile, note: iso.runDetail },
  { id: "apply", name: iso.apply, file: iso.applyFile, note: iso.applyDetail },
];
---
<div class="delivery" data-delivery data-reference={s.reference} data-inline={s.inline}>
  <div class="delivery-bar"><span>{s.label}</span><div role="group" aria-label={s.choose} class="destinations" hidden>{routes.map((route,i) => <button type="button" data-delivery-target={route.id} aria-pressed={i === 0 ? "true" : "false"}>{route.name}</button>)}</div></div>
  <figure class="delivery-figure" aria-labelledby="delivery-caption">
    <div class="delivery-visual" data-delivery-visual aria-hidden="true">
      <div class="fallback-route"><span><BrandMark size={24}/><code>patch</code></span><i>→</i><span><code data-static-destination>{routes[0]!.file}</code></span></div>
      <div class="three-space" data-delivery-space></div>
      <div class="visual-labels"><div><span>{s.context}</span><code>patch</code></div><div><span data-flat-mode>{s.reference}</span><code data-static-destination>{routes[0]!.file}</code></div></div>
      <div class="mobile-space" data-mobile-delivery>
        <div class="mobile-file"><span>{s.context}</span><code>patch</code></div>
        <div class="mobile-route"><i></i><div class="mobile-packet" data-mobile-packet><i class="paper-shape"></i></div></div>
        <div class="mobile-file mobile-destination" data-mobile-destination data-mode="reference"><span data-mobile-assistant>{routes[0]!.name}</span><code data-static-destination>{routes[0]!.file}</code><div class="mobile-received" data-mobile-received><span data-mobile-mode>{s.reference}</span><code class="mobile-reference">patch</code><div class="mobile-inline"><i class="paper-shape"></i><i class="paper-shape"></i><i class="paper-shape"></i></div></div></div>
      </div>
    </div>
    <figcaption id="delivery-caption" class="visually-hidden">{s.illustration}</figcaption>
    <button class="replay" data-delivery-replay type="button" aria-disabled="false" hidden><span aria-hidden="true">↻</span>{s.replay}</button>
  </figure>
  <div class="wiring-output">
    {routes.map((route) => <article class="wiring-route" data-wiring-route={route.id} data-file={route.file}>
      <div class="file-bar"><span>{route.name}</span></div>
      <p>{route.note}</p>
    </article>)}
  </div>
  <p class="limits">{s.limits}</p>
  <p class="unavailable">{s.unavailable}</p>
  <p class="command"><a href={localPath(lang, "/start/")}>{s.setup}<span aria-hidden="true"> ↗</span></a></p>
  <p class="delivery-scope">{s.scope}</p><span class="visually-hidden" role="status" data-delivery-status></span>
  <template data-delivery-object="source"><div class="world-file source-file"><span class="world-label">{s.context}</span><div class="world-file-head"><BrandMark size={24}/><code>patch</code></div><div class="world-papers">{Array.from({length:3},()=> <i class="paper-shape"></i>)}</div></div></template>
  <template data-delivery-object="destination"><div class="world-file destination-file" data-mode="reference"><span class="world-label" data-world-assistant>{routes[0]!.name}</span><code data-world-file>{routes[0]!.file}</code><div class="world-received"><div class="world-reference"><span>{s.reference}</span><code>patch</code></div><div class="world-inline"><span>{s.inline}</span><div class="world-papers">{Array.from({length:3},()=> <i class="paper-shape"></i>)}</div></div></div></div></template>
  <template data-delivery-object="packet"><div class="packet"><div class="packet-papers"><i class="paper-shape"></i><i class="paper-shape"></i><i class="paper-shape"></i></div><span>{s.context}</span></div></template>
  <template data-delivery-object="floor"><div class="world-floor"></div></template>
</div>

<script>
  import { Object3D, PerspectiveCamera } from "three";
  import { CSS3DObject, CSS3DRenderer } from "three/addons/renderers/CSS3DRenderer.js";
  for (const root of document.querySelectorAll<HTMLElement>("[data-delivery]")) {
    const visual = root.querySelector<HTMLElement>("[data-delivery-visual]")!;
    const buttons = [...root.querySelectorAll<HTMLButtonElement>("[data-delivery-target]")];
    const panels = [...root.querySelectorAll<HTMLElement>("[data-wiring-route]")];
    const replay = root.querySelector<HTMLButtonElement>("[data-delivery-replay]")!;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)");
    const compact = matchMedia("(max-width:640px), (max-width:1000px) and (max-height:500px)");
    const group = new Object3D();
    const camera = new PerspectiveCamera(36,1,1,2000);
    const renderer = new CSS3DRenderer();
    renderer.domElement.className = "three-root";
    root.querySelector("[data-delivery-space]")!.append(renderer.domElement);
    const object = (name:string) => {
      const template = root.querySelector<HTMLTemplateElement>(`[data-delivery-object="${name}"]`)!;
      const el = template.content.firstElementChild!.cloneNode(true) as HTMLElement;
      const item = new CSS3DObject(el); group.add(item); return item;
    };
    const source = object("source"), destination = object("destination"), packet = object("packet"), floor = object("floor");
    floor.position.set(0,-145,-30); floor.rotation.x = -Math.PI/2;
    let visible = false, frame = 0, started = 0, playing = false, progress = 1, seen = false, pointerX = 0, pointerY = 0, last = 0;
    const setBusy = (busy:boolean) => { playing = busy; replay.setAttribute("aria-disabled",String(busy)); root.dataset.deliveryPlaying = String(busy); };
    const finish = () => { progress = 1; setBusy(false); };
    const draw = (now:number) => {
      frame = 0;
      if (!visible || document.hidden) return;
      if (playing) {
        progress = Math.min(1,(now-started)/2400);
        if (progress === 1) finish();
      }
      if (now-last >= 30 || !playing) {
        last = now;
        const mobile = visual.clientWidth < 600;
        const spread = mobile ? 145 : 280;
        const p = progress*progress*(3-2*progress);
        const travel = Math.min(1,p/.75);
        const received = Math.max(0,Math.min(1,(p-.55)/.45));
        root.style.setProperty("--mobile-travel",String(travel));
        root.style.setProperty("--packet-opacity",String(1-received));
        root.style.setProperty("--received",String(received));
        source.position.set(-spread,0,-25); destination.position.set(spread,0,-25);
        source.rotation.y = mobile ? .08 : .25; destination.rotation.y = mobile ? -.08 : -.25;
        const scale = mobile ? .9 : 1;
        source.scale.setScalar(scale); destination.scale.setScalar(scale);
        packet.scale.setScalar(mobile ? .5 : .72);
        packet.position.set(-spread+2*spread*travel,100+Math.sin(travel*Math.PI)*50-80*received,100+Math.sin(travel*Math.PI)*90);
        packet.rotation.y = Math.sin(travel*Math.PI)*-.3;
        packet.element.style.opacity = String(1-received);
        destination.element.style.setProperty("--received",String(received));
        group.rotation.set(reduce.matches ? 0 : pointerY*.06,reduce.matches ? 0 : pointerX*.12,0);
        // Phones use readable native file surfaces. The same finite timeline
        // drives their packet; desktop retains the existing CSS3D projection.
        if (!compact.matches) renderer.render(group,camera);
      }
      if (playing && !reduce.matches) frame = requestAnimationFrame(draw);
    };
    const schedule = () => { if (visible && !frame && !document.hidden) frame = requestAnimationFrame(draw); };
    const resize = () => {
      const width = visual.clientWidth, height = visual.clientHeight;
      renderer.setSize(width,height); camera.aspect = width/height; camera.fov = width < 600 ? 40 : 36;
      camera.position.set(0,80,width < 600 ? 760 : 830); camera.lookAt(0,0,0); camera.updateProjectionMatrix(); schedule();
    };
    const play = () => {
      if (playing) return;
      if (reduce.matches) { finish(); schedule(); return; }
      progress = 0; started = performance.now(); setBusy(true); schedule();
    };
    const choose = (id:string, animate=true) => {
      const panel = panels.find(item => item.dataset.wiringRoute === id)!;
      const label = buttons.find(item => item.dataset.deliveryTarget === id)!.textContent!;
      for (const item of panels) item.hidden = item !== panel;
      for (const button of buttons) button.setAttribute("aria-pressed",String(button.dataset.deliveryTarget === id));
      destination.element.querySelector("[data-world-assistant]")!.textContent = label;
      destination.element.querySelector("[data-world-file]")!.textContent = panel.dataset.file!;
      destination.element.dataset.mode = id === "apply" ? "inline" : "reference";
      root.querySelector<HTMLElement>("[data-mobile-destination]")!.dataset.mode = destination.element.dataset.mode;
      root.querySelector("[data-mobile-assistant]")!.textContent = label;
      root.querySelector("[data-mobile-mode]")!.textContent = id === "apply" ? root.dataset.inline! : root.dataset.reference!;
      for (const label of root.querySelectorAll("[data-static-destination]")) label.textContent = panel.dataset.file!;
      root.querySelector("[data-flat-mode]")!.textContent = id === "apply" ? root.dataset.inline! : root.dataset.reference!;
      root.querySelector("[data-delivery-status]")!.textContent = `${label}: ${panel.dataset.file}`;
      finish(); if (animate) play(); else schedule();
    };
    root.classList.add("delivery-ready");
    root.querySelector<HTMLElement>(".destinations")!.hidden = false; replay.hidden = false;
    choose("install",false); resize();
    new ResizeObserver(resize).observe(visual);
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (!visible) { cancelAnimationFrame(frame); frame = 0; if (playing) finish(); }
      else { if (!seen) { seen = true; play(); } schedule(); }
    }).observe(visual);
    visual.addEventListener("pointermove",event => {
      if (event.pointerType !== "mouse" || reduce.matches) return;
      const rect = visual.getBoundingClientRect(); pointerX = (event.clientX-rect.left)/rect.width-.5; pointerY = (event.clientY-rect.top)/rect.height-.5; schedule();
    });
    visual.addEventListener("pointerleave",()=>{pointerX=pointerY=0;schedule();});
    for (const button of buttons) button.addEventListener("click",()=>choose(button.dataset.deliveryTarget!));
    replay.addEventListener("click",play);
    reduce.addEventListener("change",()=>{finish();pointerX=pointerY=0;cancelAnimationFrame(frame);frame=0;schedule();});
    compact.addEventListener("change",()=>{resize();schedule();});
    document.addEventListener("visibilitychange",()=>{if(document.hidden){cancelAnimationFrame(frame);frame=0;finish();}else schedule();});
  }
</script>

<style>
  .delivery { width:min(100% - 36px,1120px); margin:auto; background:var(--paper); overflow:hidden; text-align:left; }
  .delivery-bar { display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:14px; padding:14px 22px; border-block:1px solid var(--rule); font-size:12px; color:var(--muted); }
  .destinations { display:flex; gap:4px; }
  .destinations[hidden] { display:none; }
  button { font:inherit; font-size:12px; min-height:40px; padding:9px 13px; border:0; border-radius:5px; background:transparent; color:var(--muted); cursor:pointer; }
  button[aria-pressed="true"] { background:var(--paper-2); color:var(--ink); }
  .delivery-figure { margin:0; position:relative; border-bottom:1px solid var(--rule); }
  .delivery-visual { position:relative; height:410px; overflow:hidden; background:radial-gradient(ellipse at 50% 65%,var(--paper-2),var(--paper) 72%); }
  .three-space { position:absolute; inset:0; visibility:hidden; }
  .mobile-space { display:none; }
  .delivery-ready .three-space { visibility:visible; }
  .fallback-route { display:flex; align-items:center; justify-content:center; gap:28px; height:100%; }
  .fallback-route > span { display:grid; justify-items:center; gap:18px; color:var(--ink); }
  .fallback-route code { font-size:12px; }
  .fallback-route i { font-style:normal; color:var(--muted); }
  .delivery-ready .fallback-route { visibility:hidden; }
  .visual-labels { position:absolute; inset:auto 0 18px; display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:14px; max-width:690px; margin-inline:auto; padding-inline:18px; visibility:hidden; text-align:center; color:var(--ink); }
  .delivery-ready .visual-labels { visibility:visible; }
  .visual-labels > div { display:grid; align-content:start; gap:6px; }
  .visual-labels span { font-size:10px; color:var(--muted); }
  .visual-labels code { font-size:12px; overflow-wrap:anywhere; }
  .replay { display:block; margin:0 auto 14px; color:var(--ink); }
  .replay[hidden] { display:none; }
  .replay span { margin-right:8px; }
  .replay[aria-disabled="true"] { opacity:.5; }
  .wiring-output { max-width:820px; margin-inline:auto; padding:24px 28px; }
  .wiring-route + .wiring-route { margin-top:24px; }
  .wiring-route[hidden] { display:none; }
  .delivery-ready .wiring-route + .wiring-route { margin:0; }
  .file-bar { display:flex; flex-wrap:wrap; gap:10px; justify-content:space-between; color:var(--muted); font-size:11px; }
  .file-bar code { color:var(--ink); font-size:12px; overflow-wrap:anywhere; }
  pre { margin:17px 0 0; padding:18px 20px; border:1px solid var(--rule); border-radius:5px; background:var(--paper-2); white-space:pre-wrap; overflow-wrap:anywhere; }
  pre code { font-size:12px; line-height:1.7; }
  .wiring-details { margin-top:12px; }
  .wiring-details summary { min-height:36px; width:max-content; padding:8px 0; font-size:11px; color:var(--muted); cursor:pointer; }
  .wiring-route p { font-size:11px; color:var(--muted); margin:12px 0 0; }
  .command { display:flex; align-items:center; flex-wrap:wrap; gap:10px 20px; padding:16px 28px; border-top:1px solid var(--rule); }
  .command > code { font-size:14px; color:var(--ink); }
  .command button { color:var(--ink); margin-left:auto; }
  .command a { font-size:12px; color:var(--muted); }
  .command button[hidden] { display:none; }
  .limits, .unavailable { margin:0; padding:16px 28px 0; font-size:13px; line-height:1.7; color:var(--text); overflow-wrap:anywhere; }
  .unavailable { padding-top:8px; color:var(--muted); font-size:12px; }
  .delivery-scope { margin:0; padding:13px 28px; border-top:1px solid var(--rule); font-size:11px; line-height:1.7; color:var(--muted); }
  .world-file { width:360px; height:220px; padding:24px; overflow:hidden; background:var(--paper); border:1px solid var(--rule); border-radius:8px; box-shadow:0 18px 40px rgb(0 0 0 / .04); }
  .world-label { display:block; font-size:15px; color:var(--muted); margin-bottom:16px; }
  .world-file-head { display:flex; align-items:center; gap:15px; }
  .world-file-head code { color:var(--ink); font-size:19px; }
  .world-papers { display:flex; gap:14px; align-items:end; margin-top:20px; }
  .paper-shape { display:block; width:30px; height:40px; position:relative; border:1px solid var(--ink); border-radius:4px; background:var(--paper); }
  .paper-shape::before,.paper-shape::after { content:""; position:absolute; height:1px; left:7px; top:12px; width:14px; background:var(--muted); opacity:.5; }
  .paper-shape::after { top:23px; width:9px; }
  .world-received { opacity:var(--received,1); transform:translateY(calc((1 - var(--received,1)) * 25px)); margin-top:22px; }
  .world-reference { display:grid; gap:10px; padding:13px; border:1px solid var(--rule); border-radius:5px; }
  .world-reference span,.world-inline > span { font-size:12px; color:var(--muted); }
  .world-reference code { font-size:14px; color:var(--ink); }
  [data-mode="reference"] .world-inline,[data-mode="inline"] .world-reference { display:none; }
  .world-inline .world-papers { margin-top:10px; }
  .destination-file { width:280px; height:220px; }
  .destination-file > code { display:block; color:var(--ink); font-size:23px; overflow-wrap:anywhere; }
  .packet { display:grid; justify-items:center; align-content:center; gap:15px; width:140px; height:140px; border:1px solid var(--rule); border-radius:14px; background:var(--paper); color:var(--ink); box-shadow:0 12px 24px rgb(0 0 0 / .04); }
  .packet span { color:var(--muted); font-size:14px; }
  .packet-papers { position:relative; width:48px; height:52px; }
  .packet-papers .paper-shape { position:absolute; left:9px; top:6px; }
  .packet-papers .paper-shape:first-child { transform:translate(-7px,-4px) rotate(-13deg); }
  .packet-papers .paper-shape:last-child { transform:translate(7px,4px) rotate(12deg); }
  .world-floor { width:1000px; height:440px; background-image:linear-gradient(var(--rule) 1px,transparent 1px),linear-gradient(90deg,var(--rule) 1px,transparent 1px); background-size:40px 40px; opacity:.5; mask-image:radial-gradient(ellipse,#000,transparent 70%); }
  @media(max-width:640px),(max-width:1000px) and (max-height:500px) {
    .delivery-bar { padding:8px; }
    .delivery-bar > span { display:none; }
    .destinations { display:grid; grid-template-columns:minmax(0,1fr); width:100%; }
    .destinations button { min-height:44px; padding-inline:8px; font-size:12px; white-space:normal; overflow-wrap:anywhere; text-align:left; }
    .delivery-visual { height:auto; min-height:258px; }
    .delivery-ready .three-space,.visual-labels { display:none; }
    .delivery-ready .mobile-space { display:grid; grid-template-rows:auto 36px auto; padding:16px 18px; max-width:390px; margin:auto; }
    .mobile-file { padding:12px 16px; border:1px solid var(--rule); border-radius:8px; background:var(--paper); min-width:0; }
    .mobile-file > span { display:block; color:var(--muted); font-size:12px; margin-bottom:5px; }
    .mobile-file > code { display:block; font-size:14px; line-height:1.6; color:var(--ink); overflow-wrap:anywhere; }
    .mobile-route { position:relative; }
    .mobile-route > i { display:block; position:absolute; left:50%; top:0; height:100%; width:1px; background:var(--rule); }
    .mobile-packet { position:absolute; left:50%; top:0; opacity:var(--packet-opacity,0); transform:translate(-50%,calc(-45px + var(--mobile-travel,1) * 98px)); }
    .mobile-packet .paper-shape { width:26px; height:34px; box-shadow:0 4px 12px rgb(0 0 0 / .08); }
    .mobile-received { display:flex; align-items:center; flex-wrap:wrap; gap:8px; margin-top:12px; padding-top:10px; border-top:1px solid var(--rule); opacity:var(--received,1); transform:translateY(calc((1 - var(--received,1)) * 12px)); }
    .mobile-received > span { font-size:12px; color:var(--muted); }
    .mobile-reference { font-size:12px; color:var(--ink); overflow-wrap:anywhere; }
    .mobile-inline { display:flex; gap:6px; }
    .mobile-inline .paper-shape { width:14px; height:19px; border-radius:2px; }
    .mobile-inline .paper-shape::before,.mobile-inline .paper-shape::after { left:3px; top:6px; width:6px; }
    .mobile-inline .paper-shape::after { top:12px; width:4px; }
    [data-mode="reference"] .mobile-inline,[data-mode="inline"] .mobile-reference { display:none; }
    .replay { min-height:44px; margin-bottom:8px; font-size:12px; }
    .visual-labels code { font-size:11px; }
    .visual-labels { padding-inline:4px; }
    .fallback-route { min-height:258px; flex-direction:column; gap:14px; padding:18px; }
    .fallback-route code { font-size:14px; overflow-wrap:anywhere; }
    .fallback-route i { transform:rotate(90deg); }
    .delivery-ready .fallback-route { display:none; }
    .wiring-output { padding:14px 18px; }
    .wiring-route p,.file-bar,.delivery-scope { font-size:12px; }
    .wiring-details { margin-top:4px; }
    .wiring-details summary { width:100%; min-height:44px; font-size:12px; }
    .limits, .unavailable, .wiring-route p, .file-bar, .delivery-scope { font-size:12px; }
    .limits, .unavailable { padding-inline:18px; }
    .command { display:flex; padding:12px 18px; }
    .command a { display:inline-flex; align-items:center; justify-content:center; min-height:44px; }
    .delivery-scope { padding-inline:18px; }
    pre { padding:14px; }
  }
  @media(min-width:641px) and (max-width:1000px) and (max-height:500px) {
    .delivery-ready .mobile-space { grid-template-columns:minmax(0,1fr) 48px minmax(0,1fr); grid-template-rows:auto; max-width:720px; padding-block:18px; align-items:center; }
    .delivery-visual { min-height:160px; }
    .mobile-route { height:100%; min-height:60px; }
    .mobile-route > i { left:0; top:50%; width:100%; height:1px; }
    .mobile-packet { top:50%; left:0; transform:translate(calc(-30px + var(--mobile-travel,1) * 92px),-50%); }
    .command { display:flex; }
  }
</style>
