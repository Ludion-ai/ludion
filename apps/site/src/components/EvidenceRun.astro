---
import { en } from "../strings/en.ts";

interface Props {
  runner: string;
  code: string;
  /** In place of "Test (runner)". */
  label?: string;
}
const { runner, code } = Astro.props;
const label = Astro.props.label ?? (runner === "lean" ? en.lesson.proof : en.lesson.test(runner));
---

<figure class="run">
  <figcaption>
    <span>{label}</span>
    <button type="button" class="copy" data-copied={en.lesson.copied} data-failed={en.lesson.copyFailed}>{en.lesson.copy}</button>
  </figcaption>
  <pre tabindex="0"><code>{code}</code></pre>
  <span class="copy-status visually-hidden" role="status"></span>
</figure>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("button.copy")) {
    const original = button.textContent;
    button.addEventListener("click", async () => {
      const code = button.closest("figure")?.querySelector("code")?.textContent ?? "";
      try {
        await navigator.clipboard.writeText(code);
        button.textContent = button.dataset.copied ?? original;
        const status = button.closest("figure")?.querySelector(".copy-status");
        if (status) status.textContent = button.dataset.copied ?? "";
        setTimeout(() => (button.textContent = original), 2000);
      } catch {
        const status = button.closest("figure")?.querySelector(".copy-status");
        if (status) status.textContent = button.dataset.failed ?? "";
      }
    });
  }
</script>

<style>
  .run {
    margin: 0 0 20px;
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: var(--paper-2);
    overflow: hidden;
  }
  figcaption {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 6px 6px 6px 16px;
    border-bottom: 1px solid var(--rule);
    font-size: 13px;
    font-weight: 500;
    color: var(--ink);
  }
  /* A pin can be one long word (@modelcontextprotocol/client@2.0.0-beta.5), wider than a phone. */
  figcaption > span {
    overflow-wrap: anywhere;
  }
  .copy {
    flex-shrink: 0;
    font: inherit;
    font-size: 13px;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 3px;
    min-height: 40px;
    padding: 0 12px;
    cursor: pointer;
  }
  .copy:hover {
    border-color: var(--ink);
  }
  pre {
    margin: 0;
    padding: 16px;
    color: var(--ink);
    overflow-x: auto;
    line-height: 1.7;
  }
</style>
