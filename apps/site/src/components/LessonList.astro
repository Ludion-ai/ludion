---
// Every active lesson as one line: subject, the versions it holds for, its kind, a mark if it is silent, the claim's
// first sentence (a link to the lesson), and at the right each model's verdict without tools: a filled dot if it
// knows, a ring if it doesn't, a dotted ring if not measured (the marks of the knowledge dates). Filters by subject, kind, and silent hide rows; without JavaScript every row shows.
import type { Knowledge } from "../build/knowledge.ts";
import Claim from "./Claim.astro";
import { en } from "../strings/en.ts";

interface Props {
  k: Knowledge;
  labelledBy: string;
}
const { k, labelledBy } = Astro.props;
const b = en.bench;
const l = b.list;
const subjects = [...new Set(k.lessons.map((x) => x.subject))];
const kinds = [...new Set(k.lessons.map((x) => x.kind).filter((x) => x != null))].sort();
const short = (name: string) => name.replace(/^Claude\s+/, "");
---

<div class="filters" hidden>
  <fieldset>
    <legend>{l.subject}</legend>
    <label><input type="radio" name="subject" value="" checked />{l.all}</label>
    {subjects.map((s) => <label><input type="radio" name="subject" value={s} />{s}</label>)}
  </fieldset>
  <fieldset>
    <legend>{l.kind}</legend>
    <label><input type="radio" name="kind" value="" checked />{l.all}</label>
    {kinds.map((x) => <label><input type="radio" name="kind" value={x} />{b.kind[x] ?? x}</label>)}
  </fieldset>
  <fieldset class="toggle">
    <legend class="visually-hidden">{l.silent}</legend>
    <label><input type="checkbox" name="silent" />{l.silentOnly}</label>
  </fieldset>
  <p class="showing" aria-live="polite"><span data-count>{l.showing(k.lessons.length, k.lessons.length)}</span></p>
</div>

<div class="cols" aria-hidden="true" style={`--models:${k.models.length}`}>
  <span>{l.subject}</span>
  <span class="marks">{k.models.map((m) => <span>{short(m.name)}</span>)}</span>
</div>
<ol class="list" aria-labelledby={labelledBy} style={`--models:${k.models.length}`}>
  {
    k.lessons.map((x) => (
      <li data-subject={x.subject} data-kind={x.kind ?? ""} data-signal={x.signal ?? ""}>
        <span class="meta">
          <span class="subject">{x.subject}/</span>
          {x.versions && <code class="chip">{x.versions}</code>}
          {x.kind && <span class="kind">{b.kind[x.kind] ?? x.kind}</span>}
          {x.signal === "silent" && (
            <span class="silent" title={l.silentTitle}>
              {l.silent}
            </span>
          )}
        </span>
        <a class="claim" href={`/lessons/${x.id}/`}>
          <Claim text={x.sentence} />
        </a>
        <span class="marks">
          {k.models.map((m) => {
            const v = x.verdicts[m.id] ?? "none";
            return (
              <span class:list={["v", v]}>
                <i class="dot" aria-hidden="true" />
                <span class="visually-hidden">{l.verdict(m.name, b.knowledge.tip[v]!)}</span>
                <span class="who" aria-hidden="true">{short(m.name)}</span>
              </span>
            );
          })}
        </span>
      </li>
    ))
  }
</ol>

<script>
  import { en } from "../strings/en.ts";
  for (const box of document.querySelectorAll<HTMLElement>(".filters")) {
    const list = box.parentElement!.querySelector<HTMLOListElement>("ol.list")!;
    const rows = [...list.children] as HTMLElement[];
    const count = box.querySelector<HTMLElement>("[data-count]")!;
    const apply = () => {
      const form = new FormData();
      for (const input of box.querySelectorAll<HTMLInputElement>("input")) if (input.checked) form.set(input.name, input.value);
      const subject = String(form.get("subject") ?? "");
      const kind = String(form.get("kind") ?? "");
      const silent = form.has("silent");
      let shown = 0;
      for (const row of rows) {
        const on = (!subject || row.dataset.subject === subject) && (!kind || row.dataset.kind === kind) && (!silent || row.dataset.signal === "silent");
        row.hidden = !on;
        if (on) shown++;
      }
      count.textContent = en.bench.list.showing(shown, rows.length);
    };
    box.addEventListener("change", apply);
    box.hidden = false;
  }
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 24px;
    margin: 14px 0 18px;
  }
  .filters[hidden] {
    display: none;
  }
  fieldset {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin: 0;
    padding: 0;
    border: 0;
  }
  legend {
    float: left;
    margin-right: 6px;
    font-size: 13px;
    color: var(--muted);
  }
  label {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    font-size: 13px;
    color: var(--text);
    cursor: pointer;
    font-family: var(--font-code);
    font-variant-ligatures: none;
  }
  .filters input[type="radio"] {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }
  label:has(input:checked) {
    border-color: var(--ink);
    color: var(--ink);
    font-weight: 600;
  }
  label:has(input:focus-visible) {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
  .toggle input {
    margin: 0;
    accent-color: var(--ink);
  }
  .showing {
    margin: 0 0 0 auto;
    font-size: 13px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .cols,
  li {
    display: grid;
    grid-template-columns: 19.5rem 1fr calc(var(--models, 3) * 4.6rem);
    gap: 4px 20px;
    align-items: baseline;
  }
  .cols {
    grid-template-columns: 1fr calc(var(--models, 3) * 4.6rem);
    font-size: 12px;
    color: var(--muted);
    padding-bottom: 6px;
  }
  .marks {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    text-align: center;
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    padding: 10px 0;
    border-top: 1px solid var(--rule);
  }
  li[hidden] {
    display: none;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 8px;
    font-size: 13px;
  }
  .subject {
    font-family: var(--font-code);
    font-variant-ligatures: none;
    font-weight: 600;
    color: var(--ink);
    min-width: 6em;
  }
  .chip {
    padding: 1px 6px;
    border: 1px solid var(--rule);
    border-radius: 3px;
    background: var(--paper-2);
    font-size: 12px;
    color: var(--ink);
    white-space: nowrap;
  }
  .kind {
    color: var(--muted);
  }
  .silent {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink);
    border-bottom: 1.5px dotted var(--ink);
    cursor: help;
  }
  .claim {
    color: var(--ink);
    text-decoration: none;
    line-height: 1.5;
    font-size: 14.5px;
  }
  .claim:hover,
  .claim:focus-visible {
    text-decoration: underline;
  }
  .v {
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .dot {
    display: block;
    width: 11px;
    height: 11px;
    box-sizing: border-box;
    border-radius: 50%;
    border: 1.5px solid var(--mark);
  }
  .knows .dot {
    background: var(--mark);
  }
  .none .dot {
    border: 1.5px dotted var(--checking-line);
  }
  .who {
    display: none;
  }

  @media (max-width: 860px) {
    .cols {
      display: none;
    }
    li {
      grid-template-columns: 1fr;
      gap: 6px;
    }
    .marks {
      grid-auto-flow: row;
      grid-auto-columns: auto;
      display: flex;
      flex-wrap: wrap;
      gap: 4px 14px;
      text-align: left;
    }
    .v {
      display: inline-flex;
      gap: 6px;
    }
    .who {
      display: inline;
      color: var(--muted);
      font-size: 12px;
    }
    .showing {
      margin-left: 0;
    }
  }
</style>
