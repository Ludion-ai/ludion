---
import { strings, type Lang } from "../strings/index.ts";
interface Props {
  lang?: Lang;
}
const { lang = "en" } = Astro.props;
const t = strings[lang];
const v = t.home.verify;
const steps = [
  { id: "paths", label: v.steps.paths, body: v.pathsBody },
  { id: "source", label: v.steps.source, body: v.sourceBody },
  { id: "moves", label: v.steps.moves, body: v.movesBody },
  { id: "lockfile", label: v.steps.lockfile, body: v.lockfileBody },
];
---
<article class="lesson-trace" data-lesson-trace aria-label={v.title}>
  <header class="trace-bar"><span class="trace-word">{v.bar}</span></header>
  <div class="trace-workspace">
    <div class="trace-rail" data-trace-controls hidden role="group" aria-label={v.stepsLabel}>
      {steps.map((step) => (
        <button type="button" data-trace-step={step.id} aria-pressed={step.id === steps[0]!.id ? "true" : "false"} aria-controls={`trace-${step.id}`}>
          <span class="step-dot" aria-hidden="true"></span>
          <span>{step.label}</span>
        </button>
      ))}
    </div>
    <div class="trace-inspector">
      <div class="trace-panels">
        {steps.map((step) => (
          <section id={`trace-${step.id}`} class="trace-panel" data-trace-panel={step.id} aria-labelledby={`trace-${step.id}-title`}>
            <h3 id={`trace-${step.id}-title`}>{step.label}</h3>
            <p>{step.body}</p>
          </section>
        ))}
      </div>
      <p class="panel-note">{v.notVerified}</p>
      <p class="panel-note">{v.hijack}</p>
      <p class="example">{t.home.example}</p>
    </div>
  </div>
</article>

<script>
  for (const trace of document.querySelectorAll<HTMLElement>("[data-lesson-trace]")) {
    const buttons = [...trace.querySelectorAll<HTMLButtonElement>("[data-trace-step]")];
    const panels = [...trace.querySelectorAll<HTMLElement>("[data-trace-panel]")];
    const select = (id: string) => {
      for (const button of buttons) {
        button.setAttribute("aria-pressed", String(button.dataset.traceStep === id));
      }
      for (const panel of panels) panel.hidden = panel.dataset.tracePanel !== id;
    };
    trace.classList.add("trace-ready");
    trace.querySelector<HTMLElement>("[data-trace-controls]")!.hidden = false;
    select(buttons[0]!.dataset.traceStep!);
    for (const button of buttons) button.addEventListener("click", () => select(button.dataset.traceStep!));
    for (const [index, button] of buttons.entries()) button.addEventListener("keydown", (event) => {
      let next: number;
      if (event.key === "ArrowRight" || event.key === "ArrowDown") next = (index + 1) % buttons.length;
      else if (event.key === "ArrowLeft" || event.key === "ArrowUp") next = (index + buttons.length - 1) % buttons.length;
      else if (event.key === "Home") next = 0;
      else if (event.key === "End") next = buttons.length - 1;
      else return;
      event.preventDefault();
      buttons[next]!.focus();
      select(buttons[next]!.dataset.traceStep!);
    });
  }
</script>

<style>
  .lesson-trace {
    width: min(calc(100% - var(--gutter) * 2), 1000px);
    margin-inline: auto;
    border: 1px solid var(--rule);
    border-radius: 12px;
    background: var(--paper);
    overflow: hidden;
    text-align: left;
    box-shadow: 0 24px 80px rgb(0 0 0 / .045);
  }
  .trace-bar {
    display: flex;
    align-items: center;
    padding: 16px 24px;
    border-bottom: 1px solid var(--rule);
    color: var(--muted);
    font-size: 11px;
  }
  .trace-workspace { display: grid; grid-template-columns: minmax(0, 1fr); }
  .trace-ready .trace-workspace { grid-template-columns: 170px minmax(0, 1fr); }
  .trace-rail { padding: 22px 12px; border-right: 1px solid var(--rule); background: var(--paper-2); }
  .trace-rail[hidden] { display: none; }
  .trace-rail button {
    font: inherit;
    font-size: 12px;
    width: 100%;
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    margin: 0 0 7px;
    padding: 10px 12px;
    border: 1px solid transparent;
    border-radius: 7px;
    background: transparent;
    color: var(--muted);
    text-align: left;
    cursor: pointer;
  }
  .trace-rail button:hover { color: var(--ink); }
  .trace-rail button[aria-pressed="true"] { background: var(--paper); color: var(--ink); border-color: var(--rule); }
  .step-dot { width: 6px; height: 6px; border: 1px solid var(--muted); border-radius: 50%; flex-shrink: 0; }
  [aria-pressed="true"] .step-dot { background: var(--ink); border-color: var(--ink); }
  .trace-inspector { padding: 28px 32px 34px; min-width: 0; }
  .trace-panels { border-top: 1px solid var(--rule); }
  .trace-ready .trace-panels { display: grid; }
  .trace-panel { padding-top: 24px; min-width: 0; }
  .trace-ready .trace-panel { grid-area: 1 / 1; }
  .trace-ready .trace-panel[hidden] { display: block; visibility: hidden; pointer-events: none; }
  .trace-panel + .trace-panel { margin-top: 28px; }
  .trace-ready .trace-panel + .trace-panel { margin-top: 0; }
  h3 { margin: 0 0 12px; font-size: 17px; letter-spacing: -0.025em; font-weight: 450; }
  .trace-panel p, .panel-note, .example {
    margin: 0;
    color: var(--text);
    font-size: 14px;
    line-height: 1.7;
    overflow-wrap: anywhere;
  }
  .panel-note, .example { margin-top: 18px; color: var(--muted); font-size: 13px; }
  .example { font-size: 12px; }
  @media (max-width: 760px), (max-width: 1000px) and (max-height: 500px) {
    .trace-ready .trace-workspace { grid-template-columns: minmax(0, 1fr); }
    .trace-bar { padding: 8px 16px; }
    .trace-rail {
      display: flex;
      flex-wrap: wrap;
      gap: 4px;
      padding: 6px;
      border-right: 0;
      border-bottom: 1px solid var(--rule);
    }
    .trace-rail button {
      flex: 1 1 60px;
      width: auto;
      margin: 0;
      justify-content: center;
      padding: 10px 5px;
      font-size: 12px;
    }
    .step-dot { display: none; }
    .trace-inspector { padding: 18px 16px 22px; }
    .trace-ready .trace-panels { display: block; }
    .trace-ready .trace-panel[hidden] { display: none; }
    .panel-note, .example, .trace-panel p { font-size: 14px; }
  }
</style>
