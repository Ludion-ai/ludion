---
import Base from "../layouts/Base.astro";
import Claim from "./Claim.astro";
import Signature from "./Signature.astro";
import StatusChip from "./StatusChip.astro";
import SubjectTag from "./SubjectTag.astro";
import EvidenceDiff from "./EvidenceDiff.astro";
import EvidenceRun from "./EvidenceRun.astro";
import Mark from "./Mark.astro";
import EvidenceSource from "./EvidenceSource.astro";
import { claimParts } from "../build/claim-parts.ts";
import { claimSize } from "../build/claim-size.ts";
import { siteData, type LessonPage } from "../build/data.ts";
import { en, formatDate, testLabel } from "../strings/en.ts";
import { asTest, claimOf, isV1, versionOf } from "@ludion/core";

// A lesson's page: every lesson on main, replaced ones included, so history stays visible. The claim is set in
// three weights (headline, detail, and its closing sentence beside its mark), every word its own and in order.
// The panel adds whether each measured model knows the change without tools (models.json, as on /bench). A
// differential test is shown as the versions it runs on and what each must do, then its code once if the code is
// the same on every version.
const { page } = Astro.props as { page: LessonPage };
const { config, teacherHref, pages, models } = await siteData();
// Corrections are shown by their claims, not their ids.
const claimById = new Map(pages.map((p) => [p.lesson.id, claimOf(p.lesson)]));
const { lesson } = page;
const claim = claimOf(lesson);
const repo = `https://github.com/${config.org}/${config.repo}`;
const parts = claimParts(claim);
const kind = isV1(lesson) ? lesson.kind : null;
const verdicts = models ? Object.entries(models.models).map(([id, m]) => ({ id, name: m.name.replace(/^Claude\s+/, ""), v: models.lessons[lesson.id]?.[id] ?? null })) : [];
const measured = verdicts.some((m) => m.v);
const tests = lesson.evidence.map((e) => asTest(e)).filter((t) => t != null);
const sources = lesson.evidence.filter((e) => "source" in e) as { source: { url: string; quote: string } }[];
const differential = tests.length > 1 && tests.some((t) => t.expect === "fail") && tests.some((t) => t.expect !== "fail");
const sameCode = differential && new Set(tests.map((t) => t.code)).size === 1;
// One label for the shared test: the runtime, then each package with every version it runs on.
const shared = () => {
  const names = [...new Set(tests.flatMap((t) => Object.keys(t.packages ?? {})))];
  const pkgs = names.map((n) => `${n}@${[...new Set(tests.map((t) => t.packages?.[n]).filter(Boolean))].join(" / ")}`);
  return [tests[0]!.runtime, ...pkgs].join(", ");
};
---

<Base title={`${claim} | Ludion`} description={claim}>
  <article class="lesson wrap">
    {page.failedCheckAt !== null && <p class="banner" role="note">{en.lesson.failing(page.failedCheckAt ? formatDate(page.failedCheckAt) : "")}</p>}
    {
      page.correctedBy && (
        <p class="banner" role="note">
          {en.lesson.correctedBy} <a href={`/lessons/${page.correctedBy}/`}>{claimById.get(page.correctedBy) ?? page.correctedBy}</a>
        </p>
      )
    }
    <div class="top">
      <div>
        <p class="eyebrow">
          <SubjectTag subject={lesson.subject} version={versionOf(lesson)} />
          {kind && <span class="kind">{en.bench.kind[kind] ?? kind}</span>}
        </p>
        <h1 class:list={["claim", claimSize(claim)]}>
          <Claim text={parts.head} />
          {parts.detail && (
            <>
              {" "}
              <span class="detail">
                <Claim text={parts.detail} />
              </span>
            </>
          )}
          {parts.tail && (
            <>
              {" "}
              <span class:list={["tail", parts.tail.kind]}>
                {parts.tail.kind === "silent" && <Mark kind="silent" decorative />}
                {parts.tail.text}
              </span>
            </>
          )}
        </h1>
        <Signature
          teacher={page.teacher}
          teacherId={lesson.author_id}
          teacherHref={teacherHref(lesson.author_id)}
          verifiedBy={page.verified_by}
          verifiedAt={page.verified_at}
          avatar
          size="large"
          seal={false}
          drafted={isV1(lesson) && lesson.drafted_by === "agent"}
        />
      </div>
      <aside class="result" aria-label={en.lesson.verifiedBy[page.verified_by]}>
        <StatusChip status="verified" label={en.lesson.verifiedBy[page.verified_by]} by={page.verified_by} size="large" />
        <dl>
          <div><dt>{en.record.verified}</dt><dd><time datetime={page.verified_at}>{formatDate(page.verified_at)}</time></dd></div>
          <div><dt>{en.record.appliesTo}</dt><dd><SubjectTag subject={lesson.subject} version={versionOf(lesson)} /></dd></div>
          <div>
            <dt>{en.record.check}</dt>
            <dd class="links">
              <a href={`${repo}/blob/main/lessons/${lesson.subject}/${lesson.id}.json`}>{en.lesson.viewFile}</a>
              {page.pr !== null && <a href={`${repo}/pull/${page.pr}`}>{en.lesson.pullRequest(page.pr)}</a>}
            </dd>
          </div>
        </dl>
        {
          verdicts.length > 0 && (
            <div class="models">
              <p class="mh">{en.lesson.models.heading}</p>
              {measured ? (
                <ul>
                  {verdicts.map((m) => (
                    <li class={m.v ?? "none"}>
                      <i class="dot" aria-hidden="true" />
                      <a href={`/bench/${m.id}/`}>{m.name}</a>
                      <span class="v">{en.bench.knowledge.tip[m.v ?? "none"]}</span>
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="unmeasured">{en.lesson.models.none}</p>
              )}
              <p class="mnote">
                {en.lesson.models.note(formatDate(models!.measured_at))} <a href="/bench/">{en.lesson.models.link}</a>
              </p>
            </div>
          )
        }
      </aside>
    </div>

    <section class="evidence" aria-labelledby="evidence">
      <h2 id="evidence">{en.lesson.evidence}</h2>
      {differential && <EvidenceDiff runs={tests} />}
      {sameCode ? <EvidenceRun runner={shared()} code={tests[0]!.code} label={en.lesson.sameTest(shared())} /> : tests.map((t) => <EvidenceRun runner={testLabel(t)} code={t.code} />)}
      {sources.map((e) => <EvidenceSource url={e.source.url} quote={e.source.quote} />)}
      {
        page.corrects.length > 0 && (
          <div class="corrects">
            <h2>{en.lesson.corrects}</h2>
            <ul class="corrected">
              {page.corrects.map((id) => (
                <li>
                  <a href={`/lessons/${id}/`}>{claimById.get(id) ?? id}</a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </section>
  </article>
</Base>

<style>
  .top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 352px;
    gap: 56px;
    align-items: start;
    padding-bottom: 56px;
    border-bottom: 2px solid var(--rule-strong);
  }
  @media (max-width: 900px) {
    .top {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 20px;
  }
  .kind {
    font-family: var(--font-code);
    font-variant-ligatures: none;
    font-size: 12px;
    color: var(--muted);
    padding: 2px 8px;
    border: 1px solid var(--rule);
    border-radius: 999px;
  }
  h1 {
    line-height: 1.04;
    letter-spacing: -0.036em;
    margin-bottom: 28px;
    overflow-wrap: anywhere;
  }
  /* The detail and the closing sentence: the same heading, in a lighter voice. */
  .detail {
    display: block;
    margin-top: 18px;
    font-size: clamp(19px, 2vw, 24px);
    font-weight: 450;
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: var(--text);
  }
  .tail {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 18px;
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.4;
    color: var(--muted);
  }
  .tail.silent {
    color: var(--ink);
  }
  .tail :global(svg) {
    width: 18px;
    height: 18px;
  }
  .models {
    margin-top: 22px;
    padding-top: 14px;
    border-top: 1px solid var(--rule);
    font-size: 14px;
  }
  .mh {
    margin: 0 0 10px;
    font-weight: 700;
    color: var(--ink);
  }
  .models ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .models li {
    display: grid;
    grid-template-columns: 18px 1fr auto;
    align-items: center;
    padding: 5px 0;
  }
  .models li a {
    color: var(--ink);
  }
  .models .v {
    color: var(--muted);
    font-size: 13px;
  }
  .dot {
    width: 11px;
    height: 11px;
    box-sizing: border-box;
    border-radius: 50%;
    border: 1.5px solid var(--mark);
  }
  .knows .dot {
    background: var(--mark);
  }
  .none .dot {
    border-style: dotted;
    border-color: var(--checking-line);
  }
  .unmeasured,
  .mnote {
    margin: 8px 0 0;
    font-size: 12px;
    color: var(--muted);
  }
  .mnote a {
    color: var(--ink);
  }
  h1.xl { font-size: clamp(38px, 6vw, 76px); }
  h1.l { font-size: clamp(32px, 4.6vw, 56px); }
  h1.m { font-size: clamp(27px, 3.4vw, 40px); line-height: 1.1; }
  h1.s { font-size: clamp(22px, 2.5vw, 30px); line-height: 1.2; letter-spacing: -0.024em; }
  /* The result panel: the seal and the record that backs it. */
  .result {
    border-top: 2px solid var(--rule-strong);
    padding-top: 18px;
  }
  /* The large seal fits a 360 px screen. */
  @media (max-width: 400px) {
    .result :global(.seal.large) {
      height: 34px;
      font-size: 13px;
    }
  }
  dl {
    margin: 22px 0 0;
    font-size: 14px;
  }
  dl > div {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: 12px;
    padding: 10px 0;
    border-top: 1px solid var(--rule);
  }
  dt {
    color: var(--muted);
  }
  dd {
    margin: 0;
    color: var(--ink);
  }
  .links {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .evidence {
    padding-top: 40px;
  }
  .evidence h2 {
    font-size: 14px;
    font-weight: 700;
    margin-bottom: 18px;
  }
  .corrects h2 {
    margin-top: 28px;
  }
  .corrected {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .corrected li {
    padding: 12px 0;
    border-top: 1px solid var(--rule);
    font-size: 18px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  /* The lessons this one corrects: struck through, since they no longer hold. */
  .corrected a {
    color: var(--muted);
    text-decoration-line: line-through;
  }
  .corrected a:hover {
    color: var(--ink);
    text-decoration-line: line-through underline;
  }
  .banner {
    margin: 0 0 28px;
    padding: 10px 14px;
    border: 1.5px dashed var(--checking-line);
    border-radius: 3px;
    color: var(--checking-fg);
  }
  .banner a {
    color: inherit;
  }
</style>
