---
// Done 3 at a glance: per measured model, the share of questions answered right without and with ludion sync, as two
// thick bars on a 0–100% scale with the 95% Wilson interval drawn as whiskers over each, and the difference in
// percentage points beside them. Every number is the Done 3 table's "all" column (build/bench.ts). Models with no
// run in a project get an empty dotted track (on /bench, not on one model's page).
import type { Row, Table } from "../build/bench.ts";
import { en } from "../strings/en.ts";

interface Props {
  table: Table;
  /** Only this model. */
  model?: string;
  link?: boolean;
}
const { table, model, link = true } = Astro.props;
const b = en.bench;
type Measured = Extract<Row, { measured: true }>;
const measured = table.rows.filter((r): r is Measured => r.measured && (!model || r.model === model));
const models = [...new Set(measured.map((r) => r.model))].map((id) => {
  const rows = measured.filter((r) => r.model === id);
  const off = rows.find((r) => !r.sync);
  const on = rows.find((r) => r.sync);
  const share = (r: Measured) => r.cells.all!.correct / r.cells.all!.total;
  const diff = off && on ? Math.round((share(on) - share(off)) * 100) : null;
  return { id, name: rows[0]!.name, rows, diff };
});
const ghosts = model ? [] : table.rows.filter((r) => !r.measured);
const at = (x: number) => `${Math.round(x * 1000) / 10}%`;
const label = (sync: boolean) => b.modelPage.missesIn(sync);
const short = (name: string) => name.replace(/^Claude\s+/, "");
---

<div class="lift">
  {
    models.map((m) => (
      <div class="model">
        <div class="bars">
          {m.rows.map((r) => {
            const x = r.cells.all!;
            return (
              <div class="row">
                <p class="what">
                  {!model && <span class="who">{link ? <a href={`/bench/${m.id}/`}>{short(m.name)}</a> : short(m.name)}</span>}
                  <span>{label(r.sync)}</span>
                </p>
                <div class="track" role="img" aria-label={`${m.name}, ${b.lift.bar(label(r.sync), x.correct, x.total, b.percent(x.low), b.percent(x.high))}`}>
                  <span class:list={["bar", { on: r.sync }]} style={`width:${at(x.correct / x.total)}`} />
                  <span class="ci" style={`left:${at(x.low)};width:${at(x.high - x.low)}`} />
                </div>
                <p class="frac" aria-hidden="true">
                  {x.correct}
                  <span>/{x.total}</span>
                </p>
              </div>
            );
          })}
        </div>
        {m.diff !== null && (
          <p class="diff">
            <span class="big">
              {m.diff > 0 ? "+" : m.diff < 0 ? "−" : "±"}
              {Math.abs(m.diff)}
            </span>
            <span class="unit">{b.lift.points}</span>
            <span class="visually-hidden">{b.lift.difference(label(false), label(true))}</span>
          </p>
        )}
      </div>
    ))
  }
  {
    ghosts.length > 0 && (
      <div class="model ghosts">
        <div class="bars">
          {ghosts.map((r) => (
            <div class="row">
              <p class="what">
                <span class="who">{link ? <a href={`/bench/${r.model}/`}>{short(r.name)}</a> : short(r.name)}</span>
              </p>
              <div class="track empty">
                <span>{b.notMeasured}</span>
              </div>
              <p class="frac" aria-hidden="true">–</p>
            </div>
          ))}
        </div>
        <span />
      </div>
    )
  }
  <p class="scale" aria-hidden="true">
    <span>0%</span>
    <span>50%</span>
    <span>100%</span>
  </p>
</div>

<style>
  .lift {
    --label: 13rem;
    --frac: 4.5rem;
    --diff: 9rem;
  }
  .model {
    display: grid;
    grid-template-columns: 1fr var(--diff);
    gap: 0 32px;
    align-items: center;
  }
  .model + .model {
    margin-top: 22px;
  }
  .row {
    display: grid;
    grid-template-columns: var(--label) 1fr var(--frac);
    gap: 0 18px;
    align-items: center;
  }
  .row + .row {
    margin-top: 10px;
  }
  .what {
    margin: 0;
    display: flex;
    flex-direction: column;
    font-size: 13px;
    color: var(--muted);
    line-height: 1.35;
  }
  .who {
    font-size: 15px;
    font-weight: 700;
    color: var(--ink);
  }
  .who a {
    color: inherit;
    text-decoration: none;
  }
  .who a:hover {
    text-decoration: underline;
  }
  /* The model's name once, on its first row. */
  .model:not(.ghosts) .row + .row .who {
    display: none;
  }
  .track {
    position: relative;
    height: 34px;
    background: var(--paper-2);
    border-radius: 3px;
  }
  .track.empty {
    display: flex;
    align-items: center;
    padding-left: 12px;
    height: 22px;
    background: none;
    border: 1.5px dotted var(--checking-line);
    box-sizing: border-box;
    font-size: 12px;
    color: var(--muted);
  }
  .bar {
    position: absolute;
    inset: 0 auto 0 0;
    background: var(--mark);
    border-radius: 3px 0 0 3px;
    transform-origin: left;
    animation: grow 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) 0.15s both;
  }
  .bar.on {
    animation-delay: 0.35s;
  }
  /* The 95% interval: a whisker across the bar's end, capped both sides. */
  .ci {
    position: absolute;
    top: 50%;
    height: 14px;
    margin-top: -7px;
    border-left: 2px solid var(--ink);
    border-right: 2px solid var(--ink);
    box-sizing: border-box;
    background: linear-gradient(var(--ink), var(--ink)) 0 50% / 100% 2px no-repeat;
  }
  @keyframes grow {
    from {
      transform: scaleX(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bar {
      animation: none;
    }
  }
  .frac {
    margin: 0;
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .frac span {
    color: var(--muted);
    font-weight: 700;
    font-size: 15px;
  }
  .ghosts .frac {
    color: var(--muted);
    font-size: 15px;
  }
  .scale {
    display: flex;
    justify-content: space-between;
    margin: 8px calc(var(--diff) + 32px + var(--frac) + 18px) 0 calc(var(--label) + 18px);
    font-size: 11px;
    font-family: var(--font-code);
    color: var(--muted);
  }
  .diff {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    border-left: 1px solid var(--rule);
    padding-left: 24px;
  }
  .diff .big {
    font-size: 72px;
    font-weight: 820;
    letter-spacing: -0.05em;
    line-height: 0.95;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .unit {
    font-size: 13px;
    color: var(--muted);
  }
  @media (max-width: 760px) {
    .lift {
      --label: 100%;
    }
    .model {
      grid-template-columns: 1fr;
    }
    .row {
      grid-template-columns: 1fr auto;
      gap: 6px 12px;
    }
    .what {
      grid-column: 1 / -1;
      flex-direction: row;
      gap: 8px;
      align-items: baseline;
    }
    .diff {
      order: -1;
      flex-direction: row;
      align-items: baseline;
      gap: 10px;
      border-left: 0;
      padding-left: 0;
      margin-bottom: 14px;
    }
    .diff .big {
      font-size: 52px;
    }
    .scale {
      margin: 8px 4.5rem 0 0;
    }
  }
</style>
