---
// A flat cut in the water, rather than a separate object floating above it.
// The same drawing remains complete when the page's WebGL water is unavailable.
interface Props { id?: string; }
const { id = "ludion-surface" } = Astro.props;
const cut = "M 302 72 H 369 V 224 H 490 V 287 H 302 Z";
const waves = Array.from({ length: 19 }, (_, i) => {
  const y = 16 + i * 17;
  const bend = Math.sin(i * 0.52) * 5;
  return `M -24 ${y} C 92 ${y - 11} 178 ${y + 17 + bend} 272 ${y - 9} S 439 ${y - 20 - bend} 526 ${y + 9} S 663 ${y + 4} 744 ${y - 14}`;
});
---

<div class="surface" aria-hidden="true">
  <svg viewBox="0 0 720 340" preserveAspectRatio="xMidYMid slice" focusable="false">
    <defs>
      <radialGradient id={`${id}-fade`} cx="52%" cy="53%" r="58%">
        <stop offset="0" stop-color="white" />
        <stop offset="0.6" stop-color="white" stop-opacity="0.8" />
        <stop offset="1" stop-color="white" stop-opacity="0" />
      </radialGradient>
      <mask id={`${id}-field`}>
        <rect width="720" height="340" fill={`url(#${id}-fade)`} />
      </mask>
      <clipPath id={`${id}-cut`}>
        <path d={cut} />
      </clipPath>
    </defs>

    <g mask={`url(#${id}-field)`}>
      <g class="water-lines">
        {waves.map((d) => <path d={d} />)}
      </g>

      <path class="cut-bed" d={cut} />
      <g class="refracted" clip-path={`url(#${id}-cut)`}>
        <g data-surface-refraction transform="translate(16 -12) skewY(7)">
          {waves.map((d) => <path d={d} />)}
        </g>
      </g>
      <path class="cut-edge" d={cut} />
      <path class="cut-fold" d="M 369 72 V 224 H 490" />
    </g>
  </svg>
</div>

<style>
  .surface {
    --surface-line: 0.11;
    --surface-edge: 0.18;
    --surface-fold: 0.32;
    width: min(100%, 720px);
    aspect-ratio: 36 / 17;
    margin-inline: auto;
    overflow: hidden;
    pointer-events: none;
  }
  svg { display: block; width: 100%; height: 100%; }
  .water-lines, .refracted, .cut-edge, .cut-fold {
    fill: none;
    stroke: var(--ink);
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .water-lines { stroke-width: 0.8; opacity: var(--surface-line); }
  .cut-bed { fill: var(--ink); opacity: 0.78; }
  .refracted { stroke: var(--paper); stroke-width: 1; opacity: 0.65; }
  .cut-edge { stroke-width: 0.8; opacity: var(--surface-edge); }
  .cut-fold { stroke: var(--paper); stroke-width: 1.3; opacity: var(--surface-fold); }
  @media (prefers-color-scheme: dark) {
    .surface {
      --surface-line: 0.15;
      --surface-edge: 0.22;
      --surface-fold: 0.4;
    }
  }
  @media (max-width: 480px) {
    .surface { aspect-ratio: 4 / 3; }
  }
</style>
