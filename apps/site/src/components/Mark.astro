---
// A small mark that stands for a label repeated on many rows, with the words beside it for screen readers and on
// hover. "silent": a muted speaker (code written for older versions still runs, without an error). "drafted": a pen
// (a seed lesson drafted by an agent). Each page that uses them explains them once in a legend.
import { en } from "../strings/en.ts";

interface Props {
  kind: "silent" | "drafted";
  /** Show the words next to the mark (the legend). */
  label?: boolean;
}
const { kind, label = false } = Astro.props;
const words = kind === "silent" ? en.bench.list.silentTitle : en.lesson.draftedAlone;
const short = kind === "silent" ? en.bench.list.silentLegend : en.bench.list.draftedLegend;
---

<span class:list={["mark", kind]} data-tip={label ? undefined : words}>
  <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
    {
      kind === "silent" ? (
        <>
          <path d="M2.5 6h2.6L8.8 3v10L5.1 10H2.5z" fill="currentColor" />
          <path d="M10.8 6l3.6 4M14.4 6l-3.6 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none" />
        </>
      ) : (
        <path d="M3 13l.7-2.9L10.6 3.2a1.2 1.2 0 0 1 1.7 0l.5.5a1.2 1.2 0 0 1 0 1.7L5.9 12.3 3 13zM9.6 4.2l2.2 2.2" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" fill="none" />
      )
    }
  </svg>
  {label ? <span class="words">{short}</span> : <span class="visually-hidden">{words}</span>}
</span>

<style>
  .mark {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--muted);
    line-height: 1;
  }
  .mark.silent {
    color: var(--ink);
  }
  svg {
    width: 15px;
    height: 15px;
    flex: none;
  }
  .words {
    font-size: 13px;
    color: var(--muted);
  }
</style>
