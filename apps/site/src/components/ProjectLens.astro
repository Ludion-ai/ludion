---
import Claim from "./Claim.astro";
import BrandMark from "./BrandMark.astro";
import Signature from "./Signature.astro";
import { siteData } from "../build/data.ts";
import { LENS_PROJECTS, projectLens, type LensCase } from "../build/project-lens.ts";
import { formatDate } from "../strings/en.ts";

interface Props {
  copy: {
    title: string; project: string; model: string; noModel: string;
    available: string; matching: string; included: string; pruned: string; unmeasured: string;
    preview: (shown: number, matched: number) => string;
    status: (included: number, pruned: number) => string;
    lessonSelection: string; measuredMiss: string; measuredKnown: string; notMeasured: string;
    inContext: string; leftOut: string; evidence: string; subject: string; empty: string;
    scope: string; measurement: string; coverage: string;
    inspect: string; diagram: string; versionGate: string; modelGate: string; contextGate: string;
  };
}
const { copy: s } = Astro.props;
const data = await siteData();
const lens = projectLens(data.index, data.models);

// Paper positions are display geometry, not measured time or a second selection algorithm.
// Each route contains exactly one tile per package lesson; only the CLI-derived state chooses its exit.
const papers = (item: LensCase, vertical: boolean) => {
  const point = (i: number, count: number, x: number, y: number, compact = false) => {
    const columns = compact ? 3 : vertical ? 5 : 4;
    const rows = Math.ceil(count / columns);
    const scale = Math.min(compact ? vertical ? .8 : .58 : vertical ? 1.3 : 1,
      (compact ? vertical ? 60 : 45 : vertical ? 125 : 112) / Math.max(24, rows * 24));
    return [x + ((i % columns) - (columns - 1) / 2) * 23 * scale,
      y + (Math.floor(i / columns) - (rows - 1) / 2) * 24 * scale, scale];
  };
  let matched = 0, kept = 0, unmatched = 0, known = 0;
  return item.tiles.map((tile, i) => {
    const start = point(i, item.total, vertical ? 76 : 112, vertical ? 75 : 113);
    const middle = tile.matched ? point(matched++, item.matched, vertical ? 242 : 373, vertical ? 75 : 113) : start;
    const end = tile.included
      ? point(kept++, item.included, vertical ? 84 : 696, vertical ? 260 : 113)
      : tile.matched
        ? point(known++, item.pruned, vertical ? 261 : 494, vertical ? 251 : 237, true)
        : point(unmatched++, item.total - item.matched, vertical ? 228 : 237, vertical ? 173 : 237, true);
    return { ...tile, start, middle, end };
  });
};
---

<figure class="lens" data-project-lens>
  <figcaption class="lens-title"><span class="app-mark"><BrandMark size={16} /></span><span>{s.title}</span><code>.ludion/lessons.md</code></figcaption>
  <div class="inputs">
    <div class="static-project" data-lens-static><code>vitest <b>5.0.3</b></code><span>{lens.models.find((model) => model.id === lens.defaultModel)?.name || s.noModel}</span></div>
    <div class="inputs-controls" hidden>
      <label><span class="input-label">{s.project}</span><select data-lens-project>{LENS_PROJECTS.map((project) => <option value={project.id} selected={project.id === lens.defaultProject}>{project.name} {project.version}</option>)}</select><span class="selected-value" data-lens-selected="project" hidden aria-hidden="true"></span></label>
      <label><span class="input-label">{s.model}</span><select data-lens-model>{lens.models.map((model) => <option value={model.id} selected={model.id === lens.defaultModel}>{model.name || s.noModel}</option>)}</select><span class="selected-value" data-lens-selected="model" hidden aria-hidden="true"></span></label>
    </div>
  </div>
  <div class="readout">
    {lens.cases.map((item) => {
      const defaultCase = item.project.id === lens.defaultProject && item.model === lens.defaultModel;
      return <div class="lens-case" data-lens-case data-project={item.project.id} data-version={item.project.version} data-model={item.model} data-announcement={s.status(item.included, item.pruned)} hidden={!defaultCase}>
        <div class="selection-flow">
          <div><b>{item.total}</b><span>{s.available}</span></div><span class="flow-arrow" aria-hidden="true">→</span>
          <div><b>{item.matched}</b><span>{s.matching}</span></div><span class="flow-arrow" aria-hidden="true">→</span>
          <div class="included-count"><b>{item.included}</b><span>{s.included}</span></div>
        </div>
        <p class="selection-note"><span><i class="key-known" aria-hidden="true"></i>{item.pruned} {s.pruned}</span><span><i class="key-unmeasured" aria-hidden="true"></i>{item.unmeasured} {s.unmeasured}</span></p>
        <div class="selection-diagram" data-lens-diagram>
          <span class="visually-hidden">{s.diagram}</span>
          {[false, true].map((vertical) => <svg class:list={["paper-machine", vertical ? "machine-tall" : "machine-wide"]} viewBox={vertical ? "0 0 320 340" : "0 0 820 290"} aria-hidden="true">
            {vertical ? <>
              <path class="route-line" d="M76 75H242L84 260"/><path class="side-route" d="M159 75Q192 119 228 173M171 158Q242 176 261 251"/>
              <path class="gate" d="M150 27H141V137H150M168 27H177V137H168"/>
              <path class="gate" transform="translate(171 158) rotate(135)" d="M-12-48H-20V48H-12M12-48H20V48H12"/>
              <text x="159" y="16" text-anchor="middle">{s.versionGate}</text><text x="242" y="195" text-anchor="middle">{s.modelGate}</text><text x="175" y="318">{s.contextGate}</text>
              <path class="context-sheet" d="M12 183H134L155 204V329H12ZM134 183V204H155"/>
            </> : <>
              <path class="route-line" d="M111 123H707"/><path class="side-route" d="M237 123Q237 208 237 237M494 123Q494 208 494 237"/>
              <path class="gate" d="M222 67H210V179H222M252 67H264V179H252M479 67H467V179H479M509 67H521V179H509"/>
              <text x="237" y="40" text-anchor="middle">{s.versionGate}</text><text x="494" y="40" text-anchor="middle">{s.modelGate}</text><text x="696" y="21" text-anchor="middle">{s.contextGate}</text>
              <path class="context-sheet" d="M638 35H737L756 54V197H638ZM737 35V54H756"/>
            </>}
            {papers(item, vertical).map((paper) => <g class:list={["paper-tile", `paper-${paper.state}`]} data-lens-token data-state={paper.state} data-origin={paper.start.join(",")} data-middle={paper.middle.join(",")} data-end={paper.end.join(",")} data-gate={vertical ? paper.matched ? "171,158,1" : "159,75,1" : paper.matched ? "494,123,1" : "237,123,1"} transform={`translate(${paper.end[0]} ${paper.end[1]}) scale(${paper.end[2]})`}>
              <path class="paper-face" d="M-7-10H2L7-5V10H-7ZM2-10V-5H7"/><path class="paper-rule" d="M-3-1H3M-3 3H1"/>
            </g>)}
          </svg>)}
        </div>
        {item.preview.length ? <details class="inspection" data-lens-inspection>
          <summary>{s.inspect}<span aria-hidden="true">+</span></summary>
          <div class="inspection-content">
            <div class="lesson-picker" role="group" aria-label={s.lessonSelection} hidden>{item.preview.map((lesson, i) => <button type="button" data-lens-select={lesson.entry.id} aria-pressed={i === 0 ? "true" : "false"} class:list={[{ excluded: !lesson.included }]}><code>{lesson.entry.symbol}</code>{!lesson.included && <><span class="left-out" aria-hidden="true">−</span><span class="visually-hidden"> · {s.leftOut}</span></>}</button>)}</div>
            <div class="lesson-panels">
              {item.preview.map((lesson, i) => <details class="lesson-panel" data-lens-lesson={lesson.entry.id} open={i === 0}>
                <summary><code>{lesson.entry.symbol}</code></summary>
                <div class="lesson-body">
                  <p class="lesson-state"><span>{lesson.included ? s.inContext : s.leftOut}</span><code>{lesson.entry.version}</code></p>
                  <p class="generated-claim"><Claim text={lesson.entry.claim} /></p>
                  <div class="lesson-provenance"><Signature teacher={lesson.entry.teacher} teacherId={lesson.entry.teacher_id} teacherHref={data.teacherHref(lesson.entry.teacher_id)} verifiedBy={lesson.entry.verified_by} verifiedAt={lesson.entry.verified_at} drafted={lesson.entry.drafted_by === "agent"} compact /></div>
                  <div class="lesson-footer"><span class:list={["verdict", { known: lesson.verdict === "knows" }]}>{lesson.verdict === "knows" ? s.measuredKnown : lesson.verdict === "misses" ? s.measuredMiss : s.notMeasured}</span><a href={`/lessons/${lesson.entry.id}/`}>{s.evidence}<span aria-hidden="true"> ↗</span></a></div>
                </div>
              </details>)}
            </div>
            <p class="preview-scope">{s.preview(item.preview.length, item.matched)} <a href={`/${item.project.name}/`}>{s.subject}<span aria-hidden="true"> ↗</span></a></p>
          </div>
        </details> : <p class="empty">{s.empty}</p>}
      </div>;
    })}
  </div>
  <span class="visually-hidden" role="status" data-lens-status></span>
  <p class="lens-scope">{s.scope} <a href="/lessons/">{s.coverage}</a>{lens.measuredAt && <><br /><a href="/bench/method/">{s.measurement} · {formatDate(lens.measuredAt)}</a></>}</p>
</figure>

<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-project-lens]")) {
    const project = root.querySelector<HTMLSelectElement>("[data-lens-project]")!;
    const model = root.querySelector<HTMLSelectElement>("[data-lens-model]")!;
    const cases = Array.from(root.querySelectorAll<HTMLElement>("[data-lens-case]"));
    const reduce = matchMedia("(prefers-reduced-motion: reduce)");
    const compact = matchMedia("(max-width:640px), (max-width:1000px) and (max-height:500px)");
    let current = cases.find(item => !item.hidden)!;
    let frame = 0, visible = false, progress = 1, seen = false, replayStart: number | null = null;
    root.classList.add("interactive");
    root.querySelector<HTMLElement>(".inputs-controls")!.hidden = false;
    root.querySelector<HTMLElement>("[data-lens-static]")!.hidden = true;
    // Native selects stay native. If enlarged text cannot fit their single line, show the complete option below.
    // The mirror is visual only: the native option already supplies the complete selected value to assistive tech.
    const text = document.createElement("canvas").getContext("2d");
    const fitLabels = () => {
      for (const [field, key] of [[project, "project"], [model, "model"]] as const) {
        const output = root.querySelector<HTMLElement>(`[data-lens-selected="${key}"]`)!;
        const value = field.selectedOptions[0]?.textContent ?? "";
        output.textContent = value;
        if (!compact.matches || !text) { output.hidden = true; continue; }
        const style = getComputedStyle(field);
        text.font = style.font;
        const available = field.clientWidth - parseFloat(style.paddingLeft) - parseFloat(style.paddingRight) - 18;
        output.hidden = text.measureText(value).width <= available;
      }
    };
    const labelSize = new ResizeObserver(fitLabels);
    labelSize.observe(project); labelSize.observe(model);
    compact.addEventListener("change", fitLabels);
    document.fonts.ready.then(fitLabels);
    document.fonts.addEventListener("loadingdone", fitLabels);
    for (const item of cases) {
      const picker = item.querySelector<HTMLElement>(".lesson-picker");
      if (!picker) continue;
      picker.hidden = false;
      const panels = Array.from(item.querySelectorAll<HTMLDetailsElement>("[data-lens-lesson]"));
      const choose = (id: string) => {
        for (const panel of panels) { panel.open = true; panel.hidden = panel.dataset.lensLesson !== id; }
        for (const button of picker.querySelectorAll<HTMLButtonElement>("[data-lens-select]")) button.setAttribute("aria-pressed", String(button.dataset.lensSelect === id));
      };
      choose(panels[0]!.dataset.lensLesson!);
      for (const button of picker.querySelectorAll<HTMLButtonElement>("[data-lens-select]")) button.addEventListener("click", () => choose(button.dataset.lensSelect!));
      // Give every case the same disclosure state so switching never reserves an unrelated expanded case.
      item.querySelector<HTMLDetailsElement>("[data-lens-inspection]")?.addEventListener("toggle", event => {
        if (item !== current) return;
        const open = (event.target as HTMLDetailsElement).open;
        for (const other of cases) { const detail = other.querySelector<HTMLDetailsElement>("[data-lens-inspection]"); if (detail) detail.open = open; }
      });
    }
    const clamp = (value: number) => Math.min(1, Math.max(0, value));
    const ease = (value: number) => value * value * (3 - 2 * value);
    const paint = () => {
      for (const paper of current.querySelectorAll<SVGGElement>("[data-lens-token]")) {
        const start = paper.dataset.origin!.split(",").map(Number);
        const middle = paper.dataset.middle!.split(",").map(Number);
        const end = paper.dataset.end!.split(",").map(Number);
        const rejected = paper.dataset.state === "unmatched";
        const first = progress < .5 || rejected;
        const phase = clamp(first ? progress * 2 : (progress - .5) * 2);
        let from = first ? start : middle;
        let to = first ? rejected ? end : middle : end;
        let p = ease(phase);
        const exits = rejected || (!first && paper.dataset.state === "known");
        // An excluded paper reaches its own gate before turning toward the exit.
        if (exits) {
          const gate = paper.dataset.gate!.split(",").map(Number);
          if (phase < .62) { to = gate; p = ease(phase / .62); }
          else { from = gate; to = end; p = ease((phase - .62) / .38); }
        }
        const coordinates = from.map((value, i) => value + (to[i]! - value) * p);
        const tilt = (rejected ? -1 : 1) * Math.sin(p * Math.PI) * 9;
        paper.setAttribute("transform", `translate(${coordinates[0]} ${coordinates[1]}) rotate(${tilt}) scale(${coordinates[2]})`);
        // Exits fade only after their gate; an unknown tile remains in context.
        paper.style.opacity = String(exits && phase >= .62 ? 1 - .65 * p : 1);
      }
      root.dataset.lensProgress = String(progress);
      root.dataset.lensPlaying = String(replayStart !== null);
    };
    const draw = (now: number) => {
      frame = 0;
      if (!visible || document.hidden) return;
      if (replayStart !== null) {
        progress = clamp((now - replayStart) / 2800);
        if (progress === 1) replayStart = null;
      }
      paint();
      if (replayStart !== null && !reduce.matches) frame = requestAnimationFrame(draw);
    };
    const schedule = () => { if (visible && !frame && !document.hidden) frame = requestAnimationFrame(draw); };
    const scrollProgress = () => {
      if (!visible || replayStart !== null || document.hidden) return;
      progress = reduce.matches ? 1 : clamp((innerHeight * .86 - root.getBoundingClientRect().top) / (innerHeight * .62));
      schedule();
    };
    const settle = () => { cancelAnimationFrame(frame); frame = 0; replayStart = null; progress = 1; paint(); };
    const chooseCase = () => {
      const next = cases.find((item) => item.dataset.project === project.value && item.dataset.model === model.value);
      if (!next) return;
      const open = current.querySelector<HTMLDetailsElement>("[data-lens-inspection]")?.open ?? false;
      current = next;
      for (const item of cases) {
        item.hidden = item !== current;
        const detail = item.querySelector<HTMLDetailsElement>("[data-lens-inspection]");
        if (detail) detail.open = open;
      }
      root.querySelector<HTMLElement>("[data-lens-status]")!.textContent = current.dataset.announcement!;
      fitLabels();
      if (reduce.matches || !visible || document.hidden) settle();
      else { replayStart = performance.now(); progress = 0; schedule(); }
    };
    project.addEventListener("change", chooseCase);
    model.addEventListener("change", chooseCase);
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible) scrollProgress(); else settle();
    }).observe(root);
    new IntersectionObserver(([entry]) => {
      if (!entry.isIntersecting || seen) return;
      seen = true;
      visible = true;
      if (reduce.matches) settle();
      else { replayStart = performance.now(); progress = 0; schedule(); }
    }, { threshold: .22 }).observe(current.querySelector("[data-lens-diagram]")!);
    addEventListener("scroll", scrollProgress, { passive: true });
    addEventListener("resize", scrollProgress, { passive: true });
    reduce.addEventListener("change", () => { settle(); scrollProgress(); });
    document.addEventListener("visibilitychange", () => { if (document.hidden) settle(); else scrollProgress(); });
  }
</script>

<style>
  .lens { width:min(100% - 36px,1000px); margin:0 auto; border:1px solid var(--rule); border-radius:12px; overflow:hidden; background:var(--paper); color:var(--text); text-align:left; box-shadow:0 24px 80px -56px var(--bloom); }
  .lens-title { display:flex; align-items:center; gap:12px; padding:15px 24px; border-bottom:1px solid var(--rule); color:var(--muted); font-size:12px; }
  .app-mark { color:var(--ink); line-height:1; }
  .lens-title code { margin-left:auto; font-size:11px; }
  .inputs { min-width:0; padding:20px 30px; border-bottom:1px solid var(--rule); background:var(--paper-2); }
  .inputs-controls { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:36px; max-width:560px; margin:auto; }
  .inputs-controls[hidden],.static-project[hidden] { display:none; }
  .selected-value { display:none; }
  label { display:grid; gap:8px; color:var(--muted); font-size:11px; }
  select { appearance:auto; width:100%; min-width:0; min-height:44px; padding:9px 10px; border:1px solid var(--rule); border-radius:5px; background:var(--paper); color:var(--ink); font:inherit; font-size:12px; cursor:pointer; }
  .static-project { display:flex; justify-content:center; flex-wrap:wrap; gap:20px; font-size:12px; color:var(--muted); }
  .static-project code { color:var(--ink); }
  .readout { min-width:0; padding:27px 30px 0; }
  .lens-case[hidden] { display:none; }
  .interactive .readout { display:grid; }
  .interactive .lens-case { grid-area:1 / 1; }
  .interactive .lens-case[hidden] { display:block; visibility:hidden; }
  .selection-flow { display:grid; grid-template-columns:1fr 20px 1fr 20px 1fr; align-items:center; gap:8px; max-width:700px; margin:0 auto; text-align:center; }
  .selection-flow div { display:grid; gap:5px; }
  .selection-flow b { font-size:28px; font-weight:450; letter-spacing:-.05em; line-height:1.1; color:var(--ink); font-variant-numeric:tabular-nums; }
  .selection-flow span { font-size:10px; color:var(--muted); }
  .selection-flow .flow-arrow { font-size:14px; }
  .selection-diagram { margin-top:15px; }
  .paper-machine { display:block; width:100%; height:auto; overflow:visible; }
  .machine-tall { display:none; }
  .paper-machine text { fill:var(--muted); font-family:var(--font-code); font-size:11px; }
  .route-line,.side-route { fill:none; stroke:var(--rule); stroke-width:1; }
  .route-line { stroke-dasharray:2 6; }
  .side-route { stroke-dasharray:2 5; opacity:.5; }
  .gate { fill:none; stroke:var(--muted); stroke-width:1; }
  .context-sheet { fill:var(--paper-2); stroke:var(--rule); stroke-width:1; }
  .paper-face { fill:var(--paper); stroke:var(--ink); stroke-width:.9; stroke-linejoin:round; }
  .paper-rule { fill:none; stroke:var(--ink); stroke-width:.6; opacity:.55; }
  .paper-unmeasured .paper-face { stroke-dasharray:2 1.5; }
  .paper-known .paper-face,.paper-unmatched .paper-face { stroke:var(--muted); }
  .paper-known .paper-rule,.paper-unmatched .paper-rule { stroke:var(--muted); }
  .paper-known,.paper-unmatched { opacity:.35; }
  .selection-note { display:flex; justify-content:center; flex-wrap:wrap; gap:7px 30px; margin:14px 0 0; color:var(--muted); font-size:10px; }
  .selection-note > span { display:flex; align-items:center; gap:8px; }
  .selection-note i { width:9px; height:12px; border:1px solid var(--muted); border-radius:1px; }
  .key-unmeasured { border-style:dashed !important; }
  .key-known { opacity:.35; }
  .inspection { border-top:1px solid var(--rule); }
  .inspection > summary { display:flex; align-items:center; justify-content:space-between; min-height:52px; color:var(--ink); cursor:pointer; font-size:12px; list-style:none; }
  .inspection > summary::-webkit-details-marker { display:none; }
  .inspection > summary span { font-size:17px; color:var(--muted); transition:transform 180ms; }
  .inspection[open] > summary span { transform:rotate(45deg); }
  .inspection-content { padding-bottom:23px; }
  .lesson-picker { display:flex; flex-wrap:wrap; gap:5px; border-block:1px solid var(--rule); padding:9px 0; }
  .lesson-picker[hidden] { display:none; }
  button { display:flex; align-items:center; gap:6px; min-height:38px; padding:8px 10px; border:0; border-radius:4px; color:var(--muted); background:transparent; cursor:pointer; }
  button code { font-size:11px; overflow-wrap:anywhere; }
  button[aria-pressed="true"] { color:var(--ink); background:var(--paper-2); }
  .left-out { font-size:13px; }
  .lesson-panels { display:grid; }
  .lesson-panel { min-width:0; }
  .lesson-panel summary { cursor:pointer; padding:16px 0; border-top:1px solid var(--rule); }
  .lesson-panel summary code { font-size:12px; }
  .interactive .lesson-panel { grid-area:1 / 1; }
  .interactive .lesson-panel summary { display:none; }
  .lesson-panel[hidden] { display:none; }
  .interactive .lesson-panel[hidden] { display:block; visibility:hidden; }
  .lesson-body { padding:21px 0 0; }
  .lesson-state { display:flex; flex-wrap:wrap; justify-content:space-between; gap:8px; margin:0 0 15px; color:var(--muted); font-size:10px; }
  .lesson-state code { font-size:10px; }
  .generated-claim { margin:0 0 22px; font-size:15px; line-height:1.7; letter-spacing:-.01em; color:var(--ink); overflow-wrap:anywhere; }
  .lesson-provenance :global(.signature) { font-size:10px; gap:5px 10px; }
  .lesson-provenance :global(.by) { font-size:11px; font-weight:450; }
  .lesson-provenance :global(.drafted) { font-size:10px; }
  .lesson-footer { display:flex; flex-wrap:wrap; justify-content:space-between; gap:10px; margin-top:20px; color:var(--muted); font-size:10px; }
  .verdict { padding-left:11px; position:relative; }
  .verdict::before { position:absolute; left:0; top:.7em; width:4px; height:4px; border:1px solid var(--muted); border-radius:50%; content:""; }
  .verdict.known::before { background:var(--muted); }
  .lesson-footer a,.preview-scope a,.lens-scope a { color:inherit; }
  .lesson-footer a,.preview-scope a { display:inline-flex; align-items:center; min-height:24px; }
  .preview-scope { display:flex; flex-wrap:wrap; justify-content:space-between; gap:8px; margin:23px 0 0; padding-top:14px; border-top:1px solid var(--rule); font-size:10px; color:var(--muted); }
  .empty { margin:24px 0; font-size:14px; color:var(--muted); }
  .lens-scope { margin:0; padding:12px 24px; border-top:1px solid var(--rule); color:var(--muted); font-size:10px; line-height:1.8; }
  .lens-scope a { display:inline-block; min-height:24px; padding-block:3px; }
  @media(max-width:640px), (max-width:1000px) and (max-height:500px) {
    .inputs { padding:10px 14px; }
    .inputs-controls { grid-template-columns:minmax(0,1fr); gap:6px; }
    label { display:flex; flex-wrap:wrap; align-items:center; gap:8px 12px; font-size:12px; line-height:1.4; }
    .input-label { flex:0 0 5.5em; max-width:100%; overflow-wrap:anywhere; }
    select { flex:1 1 10em; width:0; max-width:100%; font-size:16px; line-height:1.35; padding:8px 10px; }
    .selected-value:not([hidden]) { display:block; flex:1 0 100%; min-width:0; max-width:100%; color:var(--ink); font-size:inherit; line-height:1.5; overflow-wrap:anywhere; }
    .readout { padding:12px 16px 0; }
    .lens-title { flex-wrap:wrap; padding:11px 18px; gap:7px; }
    .lens-title code { margin-left:auto; font-size:9px; }
