---
import { homeComparison } from "../build/home.ts";
import { siteData } from "../build/data.ts";
import { en, formatDate } from "../strings/en.ts";
const { done3, models } = await siteData();
const example = homeComparison(done3);
const s = en.home.comparison;
const name = example ? models?.models[example.model]?.name ?? example.model : "";
---
{
  example && <figure class="comparison" data-comparison>
    <figcaption>
      <span class="eyebrow">{s.recorded}</span>
      <h2>{s.title}</h2>
      <p class="question">{example.question}</p>
    </figcaption>
    <div class="switch" role="group" aria-label={s.condition} hidden>
      <button type="button" data-show="without" aria-pressed="false">{s.without}</button>
      <button type="button" data-show="with" aria-pressed="true">{s.with}</button>
    </div>
    <div class="answers">
      {[{label:s.without,key:"without",answer:example.before},{label:s.with,key:"with",answer:example.after}].map(({label,key,answer:a}) => {
        return <div class="answer" data-answer={key}>
          <p class="condition"><span>{label}</span><span class="grade">{en.bench.grade[a.grade]}</span></p>
          <blockquote aria-label={s.excerpt}>{a.excerpt}</blockquote>
          <a class="full" href={a.href}>{s.full}<span aria-hidden="true"> ↗</span></a>
        </div>;
      })}
    </div>
    <span class="answer-status visually-hidden" role="status"></span>
    <p class="method">{name} · {s.setup} · {formatDate(example.measuredAt)}<br />{s.note}{" "}<a href="/bench/method/">{en.bench.method}</a></p>
  </figure>
}
<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-comparison]")) {
    const controls = root.querySelector<HTMLElement>(".switch");
    if (!controls) continue;
    root.classList.add("interactive");
    controls.hidden = false;
    const select = (key:string, announce:boolean) => {
      for (const answer of root.querySelectorAll<HTMLElement>("[data-answer]")) answer.hidden = answer.dataset.answer !== key;
      for (const button of root.querySelectorAll<HTMLButtonElement>("[data-show]")) button.setAttribute("aria-pressed", String(button.dataset.show === key));
      if (announce) {
        const status = root.querySelector<HTMLElement>(".answer-status");
        const answer = root.querySelector<HTMLElement>(`[data-answer="${key}"]`);
        if (status) status.textContent = `${answer?.querySelector(".condition > span")?.textContent ?? ""}. ${answer?.querySelector(".grade")?.textContent ?? ""}`;
      }
    };
    select("with",false);
    for (const button of root.querySelectorAll<HTMLButtonElement>("[data-show]")) button.addEventListener("click", () => select(button.dataset.show!,true));
  }
</script>
<style>
  .comparison { margin:0; padding:26px; border:1px solid var(--rule); border-radius:4px; background:var(--paper); }
  .eyebrow { font-size:12px; color:var(--muted); }
  h2 { margin-top:10px; font-size:22px; font-weight:500; letter-spacing:-0.02em; }
  .question { margin:14px 0 24px; max-width:34em; font-size:15px; line-height:1.6; color:var(--text); }
  .answers { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:24px; }
  .switch { display:flex; gap:2px; margin-bottom:22px; padding:3px; width:fit-content; border:1px solid var(--rule); border-radius:4px; }
  .switch[hidden] {display:none;}
  .switch button {font:inherit;font-size:13px;min-height:38px;padding:8px 13px;border:0;border-radius:2px;background:transparent;color:var(--muted);cursor:pointer;transition:background 180ms ease,color 180ms ease;}
  .switch button[aria-pressed="true"] {background:var(--paper-2);color:var(--ink);}
  .interactive .answers {grid-template-columns:minmax(0,1fr);min-height:162px;}
  .interactive .answer {grid-area:1 / 1;}
  .answer[hidden] {display:none;}
  /* Both panels size the same grid cell; the inactive panel remains invisible and unfocusable. */
  .interactive .answer[hidden] {display:block;visibility:hidden;}
  .interactive .answer:not([hidden]) {animation:answer-in 220ms cubic-bezier(.2,.8,.2,1);}
  @keyframes answer-in {from {opacity:0;transform:translateY(7px);} to {opacity:1;transform:none;} }
  .answer { min-width:0; border-top:1px solid var(--rule); padding-top:14px; }
  .condition { display:flex; flex-wrap:wrap; gap:8px 12px; justify-content:space-between; margin:0 0 14px; font-size:12px; color:var(--muted); }
  .grade { color:var(--ink); }
  blockquote { margin:0; font-size:16px; font-weight:400; line-height:1.65; color:var(--ink); overflow-wrap:anywhere; }
  .full { display:inline-block; margin-top:18px; font-size:12px; color:var(--muted); }
  .method { margin:24px 0 0; border-top:1px solid var(--rule); padding-top:14px; font-size:12px; line-height:1.7; color:var(--muted); }
  .method a {color:inherit;}
  @media(prefers-reduced-motion:reduce) {.interactive .answer:not([hidden]) {animation:none;} .switch button {transition:none;} }
  @media(max-width:480px) { .comparison {padding:20px;} .answers {grid-template-columns:minmax(0,1fr);gap:22px;} }
</style>
