---
import BrandMark from "./BrandMark.astro";
import { en } from "../strings/en.ts";
const r = en.home.receipt;
---
<figure class="moment">
  <figcaption class="topline"><span class="brand"><BrandMark size={14} />{r.results}</span><span>{r.pending}</span></figcaption>
  <dl>
    {r.fields.map((field) => (
      <div>
        <dt>{field}</dt>
        <dd>{r.pending}</dd>
      </div>
    ))}
  </dl>
  <p class="results"><span>{r.results}</span><span>{r.pending}</span></p>
  <p class="scope">{r.scope}</p>
</figure>

<style>
  .moment {
    width: min(100% - 36px, 860px);
    margin: 0 auto;
    text-align: left;
    border: 1px solid var(--rule);
    border-radius: 10px;
    background: var(--paper);
    overflow: hidden;
  }
  .topline, .results {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    margin: 0;
    padding: 14px 22px;
    border-bottom: 1px solid var(--rule);
    color: var(--muted);
    font-size: 12px;
  }
  .brand { display: inline-flex; align-items: center; gap: 8px; color: var(--ink); }
  dl { margin: 0; }
  dl div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 12px 24px;
    align-items: baseline;
    padding: 12px 22px;
    border-bottom: 1px solid var(--rule);
  }
  dt { margin: 0; color: var(--muted); font-size: 13px; line-height: 1.5; overflow-wrap: anywhere; }
  dd { margin: 0; font-family: var(--font-code); font-size: 12px; color: var(--ink); }
  .results { border-bottom: 0; color: var(--ink); }
  .scope {
    margin: 0;
    padding: 12px 22px 15px;
    border-top: 1px solid var(--rule);
    color: var(--muted);
    font-size: 11px;
    line-height: 1.65;
  }
  @media (max-width: 640px) {
    dl div, .topline, .results, .scope { padding-inline: 18px; }
    dl div { grid-template-columns: minmax(0, 1fr); gap: 4px; }
    dt, .topline, .scope, .results { font-size: 12px; }
  }
</style>
