---
import BrandMark from "./BrandMark.astro";
import { strings, type Lang } from "../strings/index.ts";
interface Props {
  lang?: Lang;
}
const { lang = "en" } = Astro.props;
const r = strings[lang].home.receipt;
---
<figure class="moment">
  <figcaption class="topline"><span class="brand"><BrandMark size={14} />{r.bar}</span></figcaption>
  <dl>
    {r.fields.map((field) => (
      <div>
        <dt>{field}</dt>
        <dd>{r.pending}</dd>
      </div>
    ))}
  </dl>
  <section class="not-checked" aria-labelledby="not-checked-title">
    <h3 id="not-checked-title">{r.notCheckedTitle}</h3>
    <ul>{r.notChecked.map((item) => <li>{item}</li>)}</ul>
  </section>
  <p class="results"><span>{r.results}</span><span>{r.notDeployed}</span></p>
  <p class="scope">{r.scope}</p>
</figure>

<style>
  .moment {
    width: min(100% - 36px, 860px);
    margin: 0 auto;
    text-align: left;
    border: 1px solid var(--rule);
    border-radius: 10px;
    background: var(--paper);
    overflow: hidden;
  }
  .topline, .results {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    margin: 0;
    padding: 14px 22px;
    border-bottom: 1px solid var(--rule);
    color: var(--muted);
    font-size: 12px;
  }
  .brand { display: inline-flex; align-items: center; gap: 8px; color: var(--ink); }
  dl { margin: 0; }
  dl div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 12px 24px;
    align-items: baseline;
    padding: 12px 22px;
    border-bottom: 1px solid var(--rule);
  }
  dt { margin: 0; color: var(--muted); font-size: 13px; line-height: 1.5; overflow-wrap: anywhere; }
  dd { margin: 0; font-family: var(--font-code); font-size: 12px; color: var(--ink); }
  .not-checked { padding: 14px 22px 16px; border-bottom: 1px solid var(--rule); }
  .not-checked h3 { margin: 0 0 8px; color: var(--ink); font-size: 13px; font-weight: 500; letter-spacing: 0; }
  .not-checked ul { margin: 0; padding-left: 18px; }
  .not-checked li { color: var(--muted); font-size: 13px; line-height: 1.6; overflow-wrap: anywhere; }
  .not-checked li + li { margin-top: 4px; }
  .results { border-bottom: 0; color: var(--ink); }
  .scope {
    margin: 0;
    padding: 12px 22px 15px;
    border-top: 1px solid var(--rule);
    color: var(--muted);
    font-size: 11px;
    line-height: 1.65;
  }
  @media (max-width: 640px) {
    dl div, .topline, .results, .scope, .not-checked { padding-inline: 18px; }
    dl div { grid-template-columns: minmax(0, 1fr); gap: 4px; }
    dt, .topline, .scope, .results, .not-checked li { font-size: 12px; }
  }
</style>
