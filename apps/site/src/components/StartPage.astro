---
// The setup page in either language (/start/ and /ja/start/). The commands are the same in both.
import Base from "../layouts/Base.astro";
import Pool from "./Pool.astro";
import Coverage from "./Coverage.astro";
import { strings, type Lang } from "../strings/index.ts";
const { lang = "en" } = Astro.props as { lang?: Lang };
const s = strings[lang].start;
const commands = {
 source: "git clone https://github.com/Ludion-ai/ludion.git\ncd ludion\nnpm ci\nnpm run build -w ludion-ai",
 scan: "node packages/cli/dist/cli.js scan --dir /path/to/app",
 init: "node packages/cli/dist/cli.js init --dir /path/to/app --ecosystem npm",
 patch: "node packages/cli/dist/cli.js patch --dir /path/to/app",
 apply: "node packages/cli/dist/cli.js patch --dir /path/to/app --apply",
 watch: "node packages/cli/dist/cli.js watch --dir /path/to/app --apply --interval 900",
};
const config=JSON.stringify({schema:1,ecosystem:"npm",image:"node:24-slim",test:["npm","test"],timeout_seconds:120},null,2);
---
<Base title={s.title} description={s.description} lang={lang} page="/start/">
 <article class="start-page wrap">
  <header class="page-intro"><h1>{s.heading}</h1><p class="intro">{s.intro}</p></header>
  <Pool>
   <section class="sync" aria-labelledby="scan">
    <div class="install"><h2 id="scan">{s.scan.heading}</h2><p class="where">{s.scan.where}</p><p>{s.scan.run}</p><div class="command primary-command"><pre><code id="scan-command">{commands.scan}</code></pre><button type="button" data-copy="scan-command" data-copied={s.copied} data-selected={s.selected} aria-label={s.scan.copy} aria-live="polite" hidden>{s.copy}</button></div><p class="wiring">{s.scan.wiring}</p></div>
    <aside class="path" aria-labelledby="update-path"><h3 id="update-path" class="visually-hidden">{s.path.label}</h3><ol class="flow">{s.path.steps.map((step) => <li><span class="step-title">{step.title}</span><span class="step-detail">{step.detail}</span></li>)}</ol></aside>
   </section>
   <p class="coverage">{s.coverage}</p>
   <section class="reference" aria-labelledby="setup-details"><h2 id="setup-details">{s.reference}</h2>
    <details open><summary><span>{s.source.summary}</span><span class="summary-note">{s.source.note}</span></summary><div class="detail-body"><p>{s.source.body}</p><div class="command"><pre><code id="source-command">{commands.source}</code></pre><button type="button" data-copy="source-command" data-copied={s.copied} data-selected={s.selected} aria-label={s.source.copy} aria-live="polite" hidden>{s.copy}</button></div></div></details>
    <details><summary><span>{s.init.summary}</span><span class="summary-note">{s.init.note}</span></summary><div class="detail-body"><p>{s.init.choose}</p><div class="command"><pre><code id="init-command">{commands.init}</code></pre><button type="button" data-copy="init-command" data-copied={s.copied} data-selected={s.selected} aria-label={s.init.copy} aria-live="polite" hidden>{s.copy}</button></div><p>{s.init.edit}</p><div class="command"><pre><code>{config}</code></pre></div><p>{s.init.tests}</p></div></details>
    <details><summary><span>{s.apply.summary}</span><span class="summary-note">{s.apply.note}</span></summary><div class="detail-body"><p>{s.apply.validate}</p><div class="command"><pre><code id="patch-command">{commands.patch}</code></pre><button type="button" data-copy="patch-command" data-copied={s.copied} data-selected={s.selected} aria-label={s.apply.copyValidate} aria-live="polite" hidden>{s.copy}</button></div><p>{s.apply.apply}</p><div class="command"><pre><code id="apply-command">{commands.apply}</code></pre><button type="button" data-copy="apply-command" data-copied={s.copied} data-selected={s.selected} aria-label={s.apply.copyApply} aria-live="polite" hidden>{s.copy}</button></div><p class="apply-branches">{s.apply.branchesBefore}<code>{"ludion/<ecosystem>/<package>-<version>"}</code>{s.apply.branchesAfter}</p><p class="apply-needs">{s.apply.needs}</p><p>{s.apply.review}</p></div></details>
    <details><summary><span>{s.watch.summary}</span><span class="summary-note">{s.watch.note}</span></summary><div class="detail-body"><p>{s.watch.repeat}</p><div class="command"><pre><code id="watch-command">{commands.watch}</code></pre><button type="button" data-copy="watch-command" data-copied={s.copied} data-selected={s.selected} aria-label={s.watch.copy} aria-live="polite" hidden>{s.copy}</button></div><p>{s.watch.stop}</p></div></details>
    <details><summary><span>{s.privacy.summary}</span><span class="summary-note">{s.privacy.note}</span></summary><div class="detail-body privacy"><p>{s.privacy.requests}</p><p>{s.privacy.source}</p></div></details>
    <p class="privacy-summary">{s.summary}</p>
   </section>
  </Pool>
 </article>
 <Coverage lang={lang} />
</Base>
<script>
  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) => {
    const code = document.getElementById(button.dataset.copy!);
    if (!code) return;
    button.hidden = false;
    const label = button.textContent;
    let reset: ReturnType<typeof setTimeout>;

    button.addEventListener("click", async () => {
      clearTimeout(reset);
      try {
        await navigator.clipboard.writeText(code.textContent ?? "");
        button.textContent = button.dataset.copied ?? label;
      } catch {
        const range = document.createRange();
        range.selectNodeContents(code);
        const selection = window.getSelection();
        selection?.removeAllRanges();
        selection?.addRange(range);
        button.textContent = button.dataset.selected ?? label;
      }
      reset = setTimeout(() => { button.textContent = label; }, 2000);
    });
  });
</script>

<style>
  .start-page {
    max-width: calc(1040px + var(--gutter) * 2);
  }
  .page-intro {
    padding-block: 16px 64px;
    max-width: 40rem;
  }
  h1 {
    font-size: var(--font-title, clamp(32px, 4vw, 48px));
    font-weight: 560;
    letter-spacing: -0.04em;
    line-height: 1.1;
    text-wrap: balance;
  }
  .intro {
    margin: 20px 0 0;
    max-width: 35em;
    font-size: var(--font-body, 16px);
    line-height: 1.65;
    color: var(--muted);
  }
  .sync {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 15rem;
    gap: 48px 80px;
    padding-top: 48px;
  }
  h2 {
    font-size: 20px;
    font-weight: 560;
    letter-spacing: -0.02em;
  }
  .where {
    margin: 12px 0 24px;
    font-size: var(--font-small, 13px);
    color: var(--muted);
  }
  .command {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    border: 1px solid var(--rule);
    border-radius: 5px;
    background: var(--paper);
    padding: 16px;
  }
  .primary-command {
    padding: 22px;
  }
  pre {
    flex: 1;
    min-width: 0;
    margin: 0;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    line-height: 1.7;
  }
  pre code {
    font-size: 13px;
    color: var(--ink);
  }
  .primary-command pre code {
    font-size: 15px;
  }
  button {
    flex: 0 0 auto;
    min-height: 40px;
    min-width: 48px;
    border: 0;
    border-radius: 3px;
    padding: 4px 6px;
    margin: -2px -4px 0 0;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: 12px;
    line-height: 1.5;
    cursor: pointer;
  }
  button:hover {
    background: var(--paper-2);
    color: var(--ink);
  }
  button[hidden] {
    display: none;
  }
  .result {
    margin: 18px 0 0;
    font-size: var(--font-small, 13px);
    line-height: 1.8;
    color: var(--muted);
  }
  .result code {
    color: var(--text);
    font-size: 12px;
  }
  .wiring {
    margin: 24px 0 0;
    max-width: 42em;
    font-size: var(--font-small, 13px);
    color: var(--muted);
    line-height: 1.75;
  }
  .path {
    padding-top: 4px;
  }
  .flow {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .flow li {
    position: relative;
    padding: 0 0 36px 24px;
    border-left: 1px solid var(--rule);
  }
  .flow li:last-child {
    padding-bottom: 0;
    border-left-color: transparent;
  }
  .flow li::before {
    content: "";
    position: absolute;
    top: 5px;
    left: -4px;
    width: 7px;
    height: 7px;
    background: var(--paper);
    border: 1px solid var(--muted);
    border-radius: 50%;
  }
  .step-title,
  .step-detail {
    display: block;
  }
  .step-title {
    font-size: 13px;
    font-weight: 500;
    color: var(--ink);
  }
  .step-detail {
    margin-top: 6px;
    font-size: 12px;
    color: var(--muted);
  }
  .step-detail.file {
    font-family: var(--font-code);
    font-size: 12px;
    overflow-wrap: anywhere;
  }
  .coverage {
    margin: 36px 0 0;
    padding-top: 24px;
    border-top: 1px solid var(--rule);
    color: var(--muted);
    font-size: var(--font-small, 13px);
    line-height: 1.75;
  }
  .coverage a {
    display: inline-block;
    margin-left: 4px;
    color: var(--ink);
  }
  .reference {
    margin-top: 72px;
  }
  .reference > h2 {
    margin-bottom: 20px;
    color: var(--muted);
    font-size: var(--font-small, 13px);
    font-weight: 500;
    letter-spacing: 0;
  }
  details {
    border-top: 1px solid var(--rule);
  }
  details:last-of-type {
    border-bottom: 1px solid var(--rule);
  }
  summary {
    position: relative;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px 24px;
    padding: 22px 28px 22px 0;
    color: var(--ink);
    font-size: 15px;
    font-weight: 500;
    list-style: none;
    cursor: pointer;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: "+";
    position: absolute;
    right: 1px;
    top: 20px;
    font-size: 18px;
    font-weight: 400;
    color: var(--muted);
  }
  details[open] > summary::after {
    content: "−";
  }
  summary:hover > :first-child {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .summary-note {
    color: var(--muted);
    font-size: 12px;
    font-weight: 400;
  }
  .detail-body {
    max-width: 44rem;
    padding-bottom: 28px;
    font-size: 14px;
    line-height: 1.75;
  }
  .detail-body > p {
    margin: 0 0 18px;
  }
  .detail-body .command + .command-label {
    margin-top: 24px;
  }
  .detail-body .command-label {
    margin-bottom: 10px;
    color: var(--muted);
    font-size: 12px;
  }
  .detail-body .consent {
    margin: 20px 0 0;
    color: var(--muted);
    font-size: 13px;
  }
  .privacy-summary {
    margin: 16px 0 0;
    color: var(--muted);
    font-size: 12px;
  }
  @media (max-width: 800px) {
    .sync {
      grid-template-columns: minmax(0, 1fr);
      gap: 36px;
    }
    .flow {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
    }
    .flow li {
      padding: 18px 0 0;
      border-left: 0;
      border-top: 1px solid var(--rule);
    }
    .flow li::before {
      top: -4px;
      left: 0;
    }
  }
  @media (max-width: 540px) {
    .page-intro {
      padding-block: 8px 40px;
    }
    .sync {
      padding-top: 32px;
    }
    .primary-command {
      padding: 16px;
      gap: 8px;
    }
    .primary-command pre code {
      font-size: 13px;
    }
    .flow {
      grid-template-columns:minmax(0,1fr);
      gap:0;
    }
    .flow li {
      padding:0 0 24px 20px;
      border-top:0;
      border-left:1px solid var(--rule);
    }
    .flow li:last-child {padding-bottom:0;}
    .flow li::before {top:5px;left:-4px;}
    .step-title {
      font-size: 13px;
    }
    .step-detail {
      font-size: 12px;
      overflow-wrap: anywhere;
    }
    .step-detail.file {
      font-size: 12px;
    }
    .reference {
      margin-top: 48px;
    }
    .summary-note {
      display: none;
    }
    .command {
      gap: 8px;
      padding: 14px;
    }
    .command pre code {
      font-size: 12px;
    }
  }
</style>
