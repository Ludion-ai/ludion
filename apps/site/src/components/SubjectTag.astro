---
// A subject is a directory (lessons/<subject>/), so it reads like one: "python/", with the version after it.
// Plain text with a slash, never the seal's block. Links to the subject's page.
interface Props {
  subject: string;
  version?: string | null;
  /** False where the subject has no page (no active lesson left in it). */
  link?: boolean;
}
const { subject, version, link = true } = Astro.props;
---

<span class="tag">{link ? <a class="subject" href={`/${subject}/`}>{subject}/</a> : <span class="subject">{subject}/</span>}{version && <span class="version">{version}</span>}</span>

<style>
  .tag {
    display: inline-flex;
    gap: 8px;
    font-family: var(--font-code);
    font-variant-ligatures: none;
    font-size: 13px;
    color: var(--muted);
  }
  .subject {
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
  }
  .subject:hover {
    text-decoration: underline;
  }
</style>
