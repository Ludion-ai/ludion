---
import "../styles/global.css";
import "../styles/water.css";
import Wordmark from "../components/Wordmark.astro";
import BrandMark from "../components/BrandMark.astro";
import { siteData } from "../build/data.ts";
import { en } from "../strings/en.ts";

interface Props {
  title: string;
  description?: string;
  /** False for pages without a URL of their own (404). */
  canonical?: boolean;
  /** The public path when it differs from the built one. */
  canonicalPath?: string;
  /** Share image (a site path, 1200×630) for og:image and the large Twitter card. */
  image?: string;
  /** Keep the page out of search results (the share cards' source pages). */
  noindex?: boolean;
}
const { title, description = en.site.description, canonical = true, canonicalPath, image, noindex = false } = Astro.props;
const { config } = await siteData();
// The trailing-slash URL: the one without it only redirects (307).
const path = canonicalPath ?? (Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`);
const canonicalUrl = new URL(path, config.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonicalUrl} />}
    {noindex && <meta name="robots" content="noindex" />}
    {
      image && (
        <>
          <meta property="og:type" content="website" />
          <meta property="og:site_name" content={en.site.name} />
          <meta property="og:title" content={title} />
          <meta property="og:description" content={description} />
          <meta property="og:url" content={canonicalUrl} />
          <meta property="og:image" content={new URL(image, config.site).href} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      )
    }
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <script is:inline src="/ga.js" defer></script>
  </head>
  <body class:list={[{ showcase: Astro.url.pathname === "/" }]}>
    <a class="skip" href="#main">{en.nav.skip}</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="home" href="/" aria-label={en.site.name}><BrandMark /><Wordmark height={23} /></a>
        <nav aria-label={en.nav.label}>
          <a href="/#guard" aria-current={Astro.url.pathname === "/" ? "page" : undefined}>{en.nav.design}</a>
          <a href="/start/" aria-current={Astro.url.pathname.startsWith("/start") ? "page" : undefined}>{en.nav.start}</a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap foot">
        <p>
          {en.footer.license} <a href={`https://github.com/${config.org}/${config.repo}`}>{en.footer.github}</a>
        </p>
        <p>{en.footer.analytics}</p>
      </div>
    </footer>
    <script>
      // The water under the page's top rule, where the page marks a pool ([data-water]); otherwise it does nothing.
      import "../scripts/water.js";
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    top: 12px;
    left: var(--gutter);
    z-index: 10;
    padding: 10px 14px;
    background: var(--paper);
    color: var(--ink);
    transform: translateY(-160%);
  }
  .skip:focus {
    transform: none;
  }
  .site-header {
    border-bottom: 1px solid var(--rule);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    min-height: 64px;
  }
  .home {
    display: inline-flex;
    align-items:center;
    gap:12px;
    padding: 6px 0;
    text-decoration: none;
  }
  nav {
    display: flex;
    gap: 24px;
  }
  nav a {
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    padding: 8px 0;
  }
  nav a:hover,
  nav a[aria-current="page"] {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.45em;
  }
  main {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding-top: 56px;
  }
  body:not(.showcase) main > :global(:last-child) {
    padding-bottom: 96px;
  }
  .site-footer {
    border-top: 1px solid var(--rule);
    font-size: 14px;
    color: var(--muted);
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 32px;
    padding-block: 24px 32px;
  }
  .foot p {
    margin: 0;
  }
  .foot a {
    color: var(--ink);
  }
  .showcase .site-header { border-bottom: 0; }
  .showcase main { padding-top: 0; }
  .showcase .foot { font-size: 12px; padding-block: 18px 24px; }
  @media (max-width:760px),(max-width:1000px) and (max-height:500px) {
    .bar { flex-wrap:wrap; gap:4px 12px; min-height:60px; padding-block:6px; }
    .home { gap:8px; min-height:44px; }
    .home :global(.wordmark svg) { height:21px; }
    nav { flex-wrap:wrap; gap:4px; margin-left:auto; }
    nav a { display:inline-flex; align-items:center; justify-content:center; min-width:44px; min-height:44px; padding:8px 4px; font-size:14px; }
    .foot { line-height:1.7; }
    .foot a { display:inline-flex; align-items:center; min-height:44px; }
  }
</style>
