---
import Base from "../layouts/Base.astro";
import { en } from "../strings/en.ts";
---

<Base title={`${en.notFound.title} | Ludion`} canonical={false}>
  <div class="wrap">
    <h1>{en.notFound.body}</h1>
    <p><a href="/lessons/">{en.notFound.search}</a>{en.notFound.rest}</p>
  </div>
</Base>

<style>
  h1 {
    font-weight: 600;
    font-size: var(--font-title);
    line-height: 1.12;
    letter-spacing: -0.04em;
    margin-bottom: 20px;
  }
  p {
    max-width: 38em;
    margin: 0;
    font-size: var(--font-body);
    line-height: 1.65;
    color: var(--muted);
  }
</style>
