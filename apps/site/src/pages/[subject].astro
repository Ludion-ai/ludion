---
import { siteData } from "../build/data.ts";

// One path per subject in the index. The page only redirects: lesson pages are no longer shown.
// Subjects can't take a top-level page's name (RESERVED_SUBJECTS in packages/core; the build fails if one does).
export async function getStaticPaths() {
  const { index } = await siteData();
  return [...new Set(index.lessons.map((l) => l.subject))].map((subject) => ({ params: { subject } }));
}

return Astro.redirect("/start/", 301);
---
