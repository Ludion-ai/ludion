---
// One question in one Done 3 run: the question and its key, the agent's answer, the judge's grade and reason, and the
// session log (runs/<label>/<question>.jsonl). Log text is untrusted data (web pages, package files): it is rendered
// escaped, as text, never as HTML.
import Base from "../../../layouts/Base.astro";
import { MAX_OUTPUT, readRunLog, runSlug, type BenchQuestion, type BenchRun } from "../../../build/bench.ts";
import { siteData } from "../../../build/data.ts";
import { en } from "../../../strings/en.ts";

export async function getStaticPaths() {
  const { done3 } = await siteData();
  if (!done3) return [];
  return done3.runs.flatMap((run) =>
    done3.questions
      .filter((q) => run.answers.some((a) => a.id === q.id))
      .map((question) => ({ params: { model: run.model, run: runSlug(question.id, run) }, props: { question, run } })),
  );
}

const { question, run } = Astro.props as { question: BenchQuestion; run: BenchRun };
const { model } = Astro.params as { model: string };
const { done3, root, config, models, pages, tombstones } = await siteData();
const r = en.bench.run;
const repo = `https://github.com/${config.org}/${config.repo}/blob/main`;
const answer = run.answers.find((a) => a.id === question.id)!;
const grade = run.grades.find((g) => g.id === question.id);
const log = readRunLog(root, done3!, run, question.id);
const lesson = done3!.seeds[question.change];
const hasPage = lesson && (pages.some((x) => x.lesson.id === lesson) || tombstones.some((x) => x.id === lesson));
const name = models?.models[model]?.name ?? model;
---

<Base title={r.title(question.id, run.sync)} description={question.question} noindex>
  <article class="wrap">
    <p class="up"><a href={`/bench/${model}/`}>{name}</a></p>
    <h1><code>{question.id}</code></h1>
    <p class="cond">{en.bench.tools}, {en.bench.webSearch(run.webSearch)}, {en.bench.sync(run.sync)}</p>

    <section aria-labelledby="question">
      <h2 id="question">{r.question}</h2>
      <p class="big">{question.question}</p>
    </section>

    <section aria-labelledby="key">
      <h2 id="key">{r.key}</h2>
      <dl>
        <dt>{r.accept}</dt>
        <dd>{question.accept}</dd>
        <dt>{r.reject}</dt>
        <dd>{question.reject}</dd>
      </dl>
      {hasPage && <p class="meta"><a href={`/lessons/${lesson}/`}>{r.lesson}</a></p>}
    </section>

    <section aria-labelledby="answer">
      <h2 id="answer">{r.answer}</h2>
      <pre tabindex="0" aria-labelledby="answer"><code>{answer.answer}</code></pre>
      <p class="meta">{r.cost(answer.costUsd.toFixed(2))}</p>
    </section>

    <section aria-labelledby="grade">
      <h2 id="grade">{r.grade}</h2>
      {grade && (
        <>
          <p class="big">{en.bench.grade[grade.grade]}</p>
          <p><span class="label">{r.why}:</span> {grade.why}</p>
        </>
      )}
      <p class="meta"><a href={`${repo}/${done3!.dir}/runs/judge-${run.label}/${question.id}.jsonl`}>{r.judgeLog}</a></p>
    </section>

    <section aria-labelledby="log">
      <h2 id="log">{r.log}</h2>
      {
        log ? (
          <>
            <p class="meta">
              {r.logNote(log.path)} <a href={`${repo}/${log.path}`}>{r.raw}</a>
            </p>
            <ol class="list steps">
              {log.steps.map((s) => (
                <li class={s.kind}>
                  <p class="step">{s.kind === "tool" ? r.tool(s.name) : s.kind === "result" ? (s.error ? r.resultError : r.result) : r.text}</p>
                  <pre tabindex="0"><code>{s.kind === "tool" ? s.input : s.text}</code></pre>
                  {s.kind === "result" && s.truncated && <p class="meta">{r.truncated(MAX_OUTPUT)}</p>}
                </li>
              ))}
            </ol>
          </>
        ) : (
          <p class="meta">{r.noLog}</p>
        )
      }
    </section>
  </article>
</Base>

<style>
  .up {
    margin: 0 0 12px;
    font-size: 14px;
  }
  h1 code {
    font-size: clamp(20px, 3vw, 30px);
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .cond {
    margin: 10px 0 0;
    color: var(--muted);
    font-size: 15px;
  }
  section {
    margin-top: 32px;
    padding-top: 20px;
    border-top: 1px solid var(--rule);
    max-width: 60em;
  }
  h2 {
    font-size: 14px;
    font-weight: 700;
    margin-bottom: 10px;
  }
  .big {
    margin: 0;
    font-size: 19px;
    font-weight: 560;
    color: var(--ink);
  }
  dl {
    margin: 0;
  }
  dt {
    font-size: 14px;
    font-weight: 700;
    color: var(--ink);
  }
  dd {
    margin: 2px 0 12px;
  }
  .label {
    font-weight: 700;
    color: var(--ink);
  }
  .meta {
    font-size: 14px;
    color: var(--muted);
    margin: 8px 0 0;
  }
  .meta a {
    color: var(--ink);
  }
  pre {
    margin: 0;
    padding: 12px 14px;
    border: 1px solid var(--rule);
    border-radius: 3px;
    background: var(--paper-2);
    color: var(--ink);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    line-height: 1.55;
    max-height: 32em;
    overflow-y: auto;
  }
  .steps {
    margin-top: 16px;
  }
  .steps li {
    margin: 0 0 14px;
  }
  .step {
    margin: 0 0 4px;
    font-size: 13px;
    font-weight: 700;
    color: var(--ink);
  }
  .result .step {
    color: var(--muted);
  }
  .result pre {
    background: var(--paper);
  }
</style>
