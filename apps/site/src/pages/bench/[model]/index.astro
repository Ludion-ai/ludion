---
// One model on FreshBench: its rows of the /bench tables, every Done 3 question it didn't get right (each linked to
// the change's lesson and to the run's log), and the lessons it misses without tools (models.json).
import Base from "../../../layouts/Base.astro";
import BenchTable from "../../../components/BenchTable.astro";
import KnowledgeStrip from "../../../components/KnowledgeStrip.astro";
import LiftBars from "../../../components/LiftBars.astro";
import Measured from "../../../components/Measured.astro";
import Tip from "../../../components/Tip.astro";
import { benchModels, done3Misses, done3Table, runSlug, withoutToolsTable } from "../../../build/bench.ts";
import { knowledge } from "../../../build/knowledge.ts";
import { siteData } from "../../../build/data.ts";
import { en } from "../../../strings/en.ts";

export async function getStaticPaths() {
  const { done3, models } = await siteData();
  return benchModels(done3, models).map((m) => ({ params: { model: m.id }, props: { name: m.name } }));
}

const { model } = Astro.params as { model: string };
const { name } = Astro.props as { name: string };
const { done3, models, index, pages, tombstones, releaseDates } = await siteData();
const b = en.bench;
const p = b.modelPage;
const subjectOf = new Map(index.lessons.map((l) => [l.id, l.subject]));
const claimOf = new Map(index.lessons.map((l) => [l.id, l.claim]));
// A lesson has a page if it is on main (active or replaced) or was retracted (a tombstone).
const hasPage = new Set([...pages.map((x) => x.lesson.id), ...tombstones.map((x) => x.id)]);
const t = done3Table(done3, models);
const w = withoutToolsTable(models, subjectOf);
const runs = done3Misses(done3, model);
const measured = runs.length > 0;
const missed = models ? Object.keys(models.lessons).filter((id) => subjectOf.has(id) && models.lessons[id]![model] === "misses") : [];
const known = models ? Object.keys(models.lessons).some((id) => subjectOf.has(id) && models.lessons[id]![model]) : false;
const gradeOf = (label: string, id: string) => done3?.runs.find((r) => r.label === label)?.grades.find((g) => g.id === id)?.grade;
const k = knowledge(index, models, releaseDates);
const strip = k.strips.find((x) => x.model === model);
const modelRuns = done3?.runs.filter((r) => r.model === model).sort((x, y) => Number(x.sync) - Number(y.sync)) ?? [];
---

<Base title={p.title(name)} description={p.description(name)} image={`/bench/og/${model}.png`}>
  <article class="wrap">
    <p class="up"><a href="/bench/">{p.back}</a></p>
    <h1>{name}</h1>

    <section aria-labelledby="done3">
      <h2 id="done3">{b.done3Heading}</h2>
      {
        done3 && measured ? (
          <>
            <p class="meta"><Measured date={done3.measuredAt} /></p>
            <LiftBars table={t} model={model} />
            <h3 id="done3-subjects">{b.lift.bySubject}</h3>
            <BenchTable table={t} labelledBy="done3-subjects" tools={b.tools} model={model} link={false} />
          </>
        ) : (
          <p class="meta">{p.notMeasured}</p>
        )
      }
    </section>

    {
      runs.map(({ run, misses }) => (
        <section aria-labelledby={`misses-${run.slug}`}>
          <h2 id={`misses-${run.slug}`}>
            {p.misses}: {p.missesIn(run.sync)}
          </h2>
          {misses.length === 0 ? (
            <p>{p.noMisses}</p>
          ) : (
            <ol class="list misses">
              {misses.map((m) => (
                <li>
                  <p class="q">{m.question.question}</p>
                  <p class="under">
                    <span>{m.question.library}</span>
                    <span>{b.grade[m.grade]}</span>
                    {m.lesson && hasPage.has(m.lesson) ? (
                      <a href={`/lessons/${m.lesson}/`}>{claimOf.get(m.lesson) ?? `${b.run.lesson} ${m.lesson}`}</a>
                    ) : (
                      <span>{m.lesson ? p.unpublished : p.noLesson}</span>
                    )}
                    <a href={`/bench/${model}/${runSlug(m.question.id, run)}/`}>{p.log}</a>
                  </p>
                </li>
              ))}
            </ol>
          )}
        </section>
      ))
    }

    {
      done3 && measured && (
        <section aria-labelledby="every">
          <h2 id="every">{p.every}</h2>
          <p class="meta">{p.everyCaption}</p>
          <div class="scroll" role="region" aria-labelledby="every" tabindex="0">
            <table class="every">
              <thead>
                <tr>
                  <th scope="col" class="first">{p.question}</th>
                  <th scope="col">{p.subject}</th>
                  {modelRuns.map((r) => <th scope="col">{p.missesIn(r.sync)}</th>)}
                </tr>
              </thead>
              <tbody>
                {done3.questions.map((q) => (
                  <tr>
                    <th scope="row" class="first"><code>{q.id}</code></th>
                    <td>{q.library}</td>
                    {modelRuns.map((r) => {
                      const g = gradeOf(r.label, q.id);
                      return <td>{g ? <a href={`/bench/${model}/${runSlug(q.id, r)}/`}>{b.grade[g]}</a> : b.notMeasuredCell}</td>;
                    })}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )
    }

    {
      models && (
        <section aria-labelledby="without-tools">
          <h2 id="without-tools">{b.withoutToolsHeading}</h2>
          {known ? (
            <>
              <p class="meta"><Measured date={models.measured_at} /></p>
              {strip && <KnowledgeStrip strip={strip} lessons={k.lessons} link={false} />}
              <BenchTable table={w} labelledBy="without-tools" tools={b.noTools} model={model} link={false} />
              <h3>{p.missedLessons}</h3>
              {missed.length === 0 ? (
                <p>{p.knowsAll}</p>
              ) : (
                <ul class="list missed">
                  {missed.map((id) => (
                    <li>
                      <a href={`/lessons/${id}/`}>{claimOf.get(id)}</a> <span class="tag">{subjectOf.get(id)}</span>
                    </li>
                  ))}
                </ul>
              )}
            </>
          ) : (
            <p class="meta">{b.notMeasured}</p>
          )}
        </section>
      )
    }
  </article>
  <Tip />
</Base>

<style>
  .up {
    margin: 0 0 12px;
    font-size: 14px;
  }
  h1 {
    font-size: clamp(30px, 5vw, 52px);
    font-weight: 800;
    letter-spacing: -0.04em;
  }
  section {
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--rule);
  }
  h2 {
    font-size: 21px;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: 14px;
  }
  h3 {
    font-size: 14px;
    font-weight: 700;
    margin: 28px 0 10px;
  }
  .meta {
    font-size: 14px;
    color: var(--muted);
    margin: 0 0 20px;
  }
  .misses li,
  .missed li {
    padding: 14px 0;
    border-top: 1px solid var(--rule);
  }
  .q {
    margin: 0;
    font-weight: 560;
    color: var(--ink);
    max-width: 52em;
  }
  .under {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 18px;
    margin: 6px 0 0;
    font-size: 14px;
    color: var(--muted);
  }
  .under a {
    color: var(--ink);
  }
  .missed li {
    max-width: 52em;
  }
  .tag {
    font-size: 14px;
    color: var(--muted);
    margin-left: 6px;
  }
  .scroll {
    overflow-x: auto;
  }
  .every {
    border-collapse: separate;
    border-spacing: 0;
    font-size: 14px;
  }
  .every th,
  .every td {
    text-align: left;
    padding: 6px 20px 6px 0;
    border-top: 1px solid var(--rule);
    white-space: nowrap;
  }
  .every thead th {
    border-top: 0;
    color: var(--muted);
    font-weight: 600;
  }
  .every tbody th {
    font-weight: 500;
  }
  .every .first {
    position: sticky;
    left: 0;
    background: var(--paper);
  }
</style>
