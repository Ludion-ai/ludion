---
// FreshBench results. Every number comes from docs/bench (build/bench.ts, build/knowledge.ts): models.json for what
// each model knows without tools, the Done 3 run's grades, and release-dates.json for when each change came out.
// A big statement and three figures up top, each a link to its section; then the sections, each a numbered heading,
// one or two lines, and its figure. "Doesn't know" is shown as empty squares, the words one hover or click away; the
// tables and the method are folded at the end. It took over /models (which redirects here, public/_redirects).
import Base from "../../layouts/Base.astro";
import BenchTable from "../../components/BenchTable.astro";
import KnowledgeDates from "../../components/KnowledgeDates.astro";
import KnowledgeMatrix from "../../components/KnowledgeMatrix.astro";
import LessonList from "../../components/LessonList.astro";
import LiftBars from "../../components/LiftBars.astro";
import Measured from "../../components/Measured.astro";
import Tip from "../../components/Tip.astro";
import { done3Table, reproduceCommand, withoutToolsTable, type Row } from "../../build/bench.ts";
import { dateAxis, dayOf, knowledge } from "../../build/knowledge.ts";
import { siteData } from "../../build/data.ts";
import { en } from "../../strings/en.ts";

const { done3, models, index, config, releaseDates } = await siteData();
const b = en.bench;
const repo = `https://github.com/${config.org}/${config.repo}`;
const subjectOf = new Map(index.lessons.map((l) => [l.id, l.subject]));
const t = done3Table(done3, models);
const w = withoutToolsTable(models, subjectOf);
const k = knowledge(index, models, releaseDates);
const axis = dateAxis(k, releaseDates);
const measuredLessons = k.lessons.filter((l) => Object.values(l.verdicts).some((v) => v)).length;
const cutoffSource = axis?.rows.find((r) => r.cutoff)?.cutoff?.url;

// The figures up top follow one model: the one measured in a project, else the first one measured at all.
type Measured = Extract<Row, { measured: true }>;
const runs = t.rows.filter((r): r is Measured => r.measured);
const lead = runs[0]?.model ?? k.strips.find((s) => s.misses.total > 0)?.model;
const leadStrip = k.strips.find((s) => s.model === lead);
const leadName = (leadStrip?.name ?? "").replace(/^Claude\s+/, "");
const off = runs.find((r) => r.model === lead && !r.sync)?.cells.all;
const on = runs.find((r) => r.model === lead && r.sync)?.cells.all;
const cutoff = lead ? releaseDates?.cutoffs[lead] : undefined;
const cutoffEnd = cutoff ? dayOf(new Date(Date.UTC(+cutoff.month.slice(0, 4), +cutoff.month.slice(5, 7), 0)).toISOString().slice(0, 10)) : null;
const after = cutoffEnd != null ? k.lessons.filter((l) => l.released && dayOf(l.released) > cutoffEnd).length : 0;
const leadDots = axis?.rows.find((r) => r.model === lead);
const pct = (x: number) => `${Math.round(x * 1000) / 10}%`;
let n = 0;
---

<Base title={b.title} description={b.hero.sub}>
  <article>
    <header class="hero wrap">
      <p class="eyebrow">{b.hero.eyebrow}</p>
      <h1>{b.hero.heading}</h1>
      <p class="sub">{b.hero.sub}</p>

      {
        leadStrip && (
          <ul class="tiles">
            <li>
              <a href="#knowledge">
                <span class="fig squares" aria-hidden="true">
                  {k.lessons
                    .filter((l) => l.verdicts[lead!])
                    .map((l) => (
                      <i class={l.verdicts[lead!]!} />
                    ))}
                </span>
                <span class="num">
                  {leadStrip.misses.correct}
                  <span class="of">/{leadStrip.misses.total}</span>
                </span>
                <span class="what">{b.hero.knowledge(leadName)}</span>
              </a>
            </li>
            {off && on && (
              <li>
                <a href="#done3">
                  <span class="fig bars" aria-hidden="true">
                    <i style={`width:${pct(off.correct / off.total)}`} />
                    <i style={`width:${pct(on.correct / on.total)}`} />
                  </span>
                  <span class="num">
                    {off.correct}
                    <span class="arrow"> → </span>
                    {on.correct}
                  </span>
                  <span class="what">{b.hero.lift(off.total, leadName)}</span>
                </a>
              </li>
            )}
            {cutoff && leadDots && axis && (
              <li>
                <a href="#dates">
                  <span class="fig line" aria-hidden="true">
                    {leadDots.cutoff && <b style={`left:${pct(leadDots.cutoff.from)};width:${pct(leadDots.cutoff.to - leadDots.cutoff.from)}`} />}
                    {leadDots.dots.map((d) => (
                      <i class={d.verdict ?? "none"} style={`left:${pct(d.x)}`} />
                    ))}
                  </span>
                  <span class="num">{b.month(cutoff.month)}</span>
                  <span class="what">{b.hero.cutoff(leadName, after, axis.dated)}</span>
                </a>
              </li>
            )}
          </ul>
        )
      }
    </header>

    <div class="wrap">
      {!done3 && !models && <p>{b.none}</p>}

      {
        models && (
          <section aria-labelledby="knowledge" id="knowledge-section">
            <div class="shead">
              <p class="no" aria-hidden="true">{b.section(++n)}</p>
              <h2 id="knowledge">{b.knowledge.heading}</h2>
              <div class="note">
                <p>{b.knowledge.short}</p>
                <p class="keys" aria-hidden="true">
                  <span><i class="key knows" />{b.knowledge.tip.knows}</span>
                  <span><i class="key misses" />{b.knowledge.tip.misses}</span>
                  <span><i class="key none" />{b.knowledge.tip.none}</span>
                </p>
                <p class="meta">
                  <Measured date={models.measured_at} /> <a href={`${repo}/tree/main/${models.bench}`}>{b.data}</a>
                </p>
              </div>
            </div>
            <KnowledgeMatrix k={k} />
          </section>
        )
      }

      {
        done3 && (
          <section aria-labelledby="done3">
            <div class="shead">
              <p class="no" aria-hidden="true">{b.section(++n)}</p>
              <h2 id="done3">{b.lift.heading}</h2>
              <div class="note">
                <p>{b.lift.short(done3.questions.length, new Set(Object.values(done3.seeds)).size, done3.frozenAt)}</p>
                <p class="meta">
                  <Measured date={done3.measuredAt} /> <a href={`${repo}/tree/main/${done3.dir}`}>{b.data}</a>
                </p>
              </div>
            </div>
            <LiftBars table={t} />
            <details>
              <summary id="by-subject">{b.lift.bySubject}</summary>
              <BenchTable table={t} labelledBy="by-subject" tools={b.tools} />
            </details>
          </section>
        )
      }

      {
        axis && (
          <section aria-labelledby="dates">
            <div class="shead">
              <p class="no" aria-hidden="true">{b.section(++n)}</p>
              <h2 id="dates">{b.dates.heading}</h2>
              <div class="note">
                <p>{b.dates.short}</p>
                <p class="meta">
                  <a href={`${repo}/blob/main/docs/bench/release-dates.json`}>{b.dates.source}</a>
                  {cutoffSource && (
                    <>
                      {" · "}
                      <a href={cutoffSource}>{b.dates.cutoffSource}</a>
                    </>
                  )}
                </p>
              </div>
            </div>
            <KnowledgeDates axis={axis} measuredAt={k.measuredAt!} />
            {(axis.notNpm > 0 || axis.unfetched > 0) && (
              <p class="foot">
                {axis.notNpm > 0 && b.dates.notNpm(axis.notNpm)} {axis.unfetched > 0 && b.dates.unfetched(axis.unfetched)}
              </p>
            )}
          </section>
        )
      }

      {
        models && (
          <section aria-labelledby="every">
            <div class="shead">
              <p class="no" aria-hidden="true">{b.section(++n)}</p>
              <h2 id="every">{b.list.heading}</h2>
              <div class="note">
                <p>{b.list.short}</p>
              </div>
            </div>
            <LessonList k={k} labelledBy="every" />
          </section>
        )
      }

      <details class="method">
        <summary>{b.methodDetails}</summary>
        <p class="links">
          <a href="/bench/method/">{b.method}</a>
          <a href="/bench.json">{b.json}</a>
        </p>
        {
          done3 && (
            <>
              <h3 id="reproduce">{b.reproduce}</h3>
              <pre tabindex="0" aria-labelledby="reproduce"><code>{reproduceCommand(done3)}</code></pre>
              <p class="foot">{b.reproduceNote(done3.dir)}</p>
            </>
          )
        }
        {
          models && (
            <>
              <h3 id="without-tools">{b.withoutToolsHeading}</h3>
              <p>{b.withoutToolsCaption(measuredLessons)}</p>
              <BenchTable table={w} labelledBy="without-tools" tools={b.noTools} />
            </>
          )
        }
      </details>
    </div>
  </article>
  <Tip />
</Base>

<style>
  .hero {
    padding-block: 8px 24px;
  }
  .eyebrow {
    margin: 0 0 18px;
    font-family: var(--font-code);
    font-variant-ligatures: none;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  h1 {
    font-weight: 820;
    font-size: clamp(46px, 8.6vw, 116px);
    line-height: 0.92;
    letter-spacing: -0.055em;
    margin-left: -0.04em;
    max-width: 10em;
  }
  .sub {
    margin: 26px 0 0;
    max-width: 34em;
    font-size: clamp(17px, 1.9vw, 21px);
    line-height: 1.45;
    color: var(--text);
  }

  /* Three figures, each a door to its section. */
  .tiles {
    list-style: none;
    margin: 56px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    border-top: 2px solid var(--rule-strong);
  }
  .tiles li + li {
    border-left: 1px solid var(--rule);
  }
  .tiles a {
    display: flex;
    flex-direction: column;
    gap: 10px;
    height: 100%;
    box-sizing: border-box;
    padding: 24px 28px 24px 0;
    color: inherit;
    text-decoration: none;
  }
  .tiles li + li a {
    padding-left: 28px;
  }
  .tiles a:hover .num {
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 6px;
  }
  .num {
    font-size: clamp(40px, 5vw, 60px);
    font-weight: 820;
    letter-spacing: -0.045em;
    line-height: 1;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .num .of,
  .num .arrow {
    color: var(--muted);
    font-weight: 700;
  }
  .what {
    font-size: 14px;
    line-height: 1.45;
    color: var(--muted);
    max-width: 22em;
  }
  .fig {
    display: block;
    height: 30px;
    position: relative;
  }
  .fig.squares {
    display: flex;
    flex-wrap: wrap;
    gap: 3px;
    height: auto;
    min-height: 30px;
    max-width: 15rem;
    align-content: flex-end;
  }
  .fig.squares i {
    width: 10px;
    height: 10px;
    box-sizing: border-box;
    border: 1.5px solid var(--mark);
    border-radius: 1.5px;
  }
  .fig.squares i.knows {
    background: var(--mark);
  }
  .fig.bars {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 4px;
  }
  .fig.bars i {
    display: block;
    height: 10px;
    background: var(--mark);
    border-radius: 0 2px 2px 0;
  }
  .fig.line {
    max-width: 16rem;
    border-bottom: 1px solid var(--rule-strong);
  }
  .fig.line b {
    position: absolute;
    top: 0;
    bottom: 0;
    background: var(--paper-2);
  }
  .fig.line i {
    position: absolute;
    bottom: 5px;
    width: 7px;
    height: 7px;
    margin-left: -3.5px;
    box-sizing: border-box;
    border-radius: 50%;
    border: 1.5px solid var(--mark);
    background: var(--paper);
  }
  .fig.line i.knows {
    background: var(--mark);
  }
  .fig.line i.none {
    border: 1.5px dotted var(--checking-line);
  }

  section {
    margin-top: 88px;
  }
  /* A section's head: its number and heading on the left, a line or two and its key on the right. */
  .shead {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-rows: auto auto;
    gap: 6px 48px;
    padding-top: 18px;
    margin-bottom: 30px;
    border-top: 2px solid var(--rule-strong);
  }
  .no {
    margin: 0;
    font-family: var(--font-code);
    font-variant-ligatures: none;
    font-size: 13px;
    color: var(--muted);
  }
  h2 {
    grid-column: 1;
    grid-row: 2;
    font-size: clamp(28px, 3.4vw, 40px);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }
  .note {
    grid-column: 2;
    grid-row: 1 / span 2;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 15px;
    line-height: 1.5;
    color: var(--text);
  }
  .note p {
    margin: 0;
  }
  .meta,
  .foot {
    font-size: 13px;
    color: var(--muted);
  }
  .meta a,
  .foot a {
    color: var(--ink);
  }
  .meta a {
    margin-left: 6px;
  }
  .foot {
    margin: 14px 0 0;
  }
  .keys {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    font-size: 13px;
    color: var(--muted);
  }
  .keys span {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }
  .key {
    display: inline-block;
    width: 12px;
    height: 12px;
    box-sizing: border-box;
    border-radius: 2px;
    border: 1.5px solid var(--mark);
  }
  .key.knows {
    background: var(--mark);
  }
  .key.none {
    border-style: dotted;
    border-color: var(--checking-line);
  }
  @media (max-width: 760px) {
    .shead {
      grid-template-columns: 1fr;
      gap: 6px;
    }
    .note {
      grid-column: 1;
      grid-row: auto;
      margin-top: 10px;
    }
    .tiles li + li {
      border-left: 0;
      border-top: 1px solid var(--rule);
    }
    .tiles li + li a {
      padding-left: 0;
    }
    section {
      margin-top: 64px;
    }
  }

  details {
    margin-top: 22px;
  }
  summary {
    cursor: pointer;
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 14px;
  }
  details.method {
    margin-top: 88px;
    padding-top: 18px;
    border-top: 2px solid var(--rule-strong);
  }
  details.method > summary {
    font-size: 17px;
    font-weight: 700;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 24px;
    margin: 0 0 8px;
    font-size: 15px;
  }
  h3 {
    font-size: 14px;
    font-weight: 700;
    margin: 28px 0 10px;
  }
  pre {
    margin: 0;
    padding: 14px 16px;
    border: 1px solid var(--rule);
    border-radius: 3px;
    background: var(--paper-2);
    color: var(--ink);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    line-height: 1.6;
  }
</style>
