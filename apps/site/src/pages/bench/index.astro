---
// FreshBench results. Every number comes from docs/bench (build/bench.ts): the Done 3 run's grades and models.json.
// This page took over /models (which redirects here, public/_redirects).
import Base from "../../layouts/Base.astro";
import BenchTable from "../../components/BenchTable.astro";
import Measured from "../../components/Measured.astro";
import { done3Table, reproduceCommand, withoutToolsTable } from "../../build/bench.ts";
import { siteData } from "../../build/data.ts";
import { en } from "../../strings/en.ts";

const { done3, models, index, config } = await siteData();
const b = en.bench;
const repo = `https://github.com/${config.org}/${config.repo}`;
const active = new Map(index.lessons.map((l) => [l.id, l]));
const subjectOf = new Map(index.lessons.map((l) => [l.id, l.subject]));
const t = done3Table(done3, models);
const w = withoutToolsTable(models, subjectOf);
const perLesson = models ? Object.keys(models.lessons).filter((id) => active.has(id)).map((id) => ({ lesson: active.get(id)!, verdicts: models.lessons[id]! })) : [];
const ids = models ? Object.keys(models.models) : [];
---

<Base title={b.title} description={b.intro}>
  <article class="wrap">
    <h1>{b.heading}</h1>
    <p class="intro">{b.intro}</p>
    <p class="links">
      <a href="/bench/method/">{b.method}</a>
      <a href="/bench.json">{b.json}</a>
    </p>

    {!done3 && !models && <p>{b.none}</p>}

    {
      done3 && (
        <section aria-labelledby="done3">
          <h2 id="done3">{b.done3Heading}</h2>
          <p class="caption">{b.done3Caption(done3.questions.length)}</p>
          <p class="meta">
            <Measured date={done3.measuredAt} /> <a href={`${repo}/tree/main/${done3.dir}`}>{b.files}</a>
          </p>
          <BenchTable table={t} labelledBy="done3" tools={b.tools} />
          <h3 id="reproduce">{b.reproduce}</h3>
          <pre tabindex="0" aria-labelledby="reproduce"><code>{reproduceCommand(done3)}</code></pre>
          <p class="note">{b.reproduceNote}</p>
        </section>
      )
    }

    {
      models && (
        <section aria-labelledby="without-tools">
          <h2 id="without-tools">{b.withoutToolsHeading}</h2>
          <p class="caption">{b.withoutToolsCaption(perLesson.length)}</p>
          <p class="meta">
            <Measured date={models.measured_at} /> <a href={`${repo}/tree/main/${models.bench}`}>{b.files}</a>
          </p>
          <BenchTable table={w} labelledBy="without-tools" tools={b.noTools} />

          <h3 id="per-lesson">{b.perLesson}</h3>
          <div class="scroll" role="region" aria-labelledby="per-lesson" tabindex="0">
            <table class="lessons">
              <thead>
                <tr>
                  <th scope="col" class="first">{b.lesson}</th>
                  {ids.map((id) => <th scope="col"><a href={`/bench/${id}/`}>{models.models[id]!.name}</a></th>)}
                </tr>
              </thead>
              <tbody>
                {perLesson.map(({ lesson, verdicts }) => (
                  <tr>
                    <th scope="row" class="first"><a href={`/lessons/${lesson.id}/`}>{lesson.claim}</a></th>
                    {ids.map((id) => <td>{verdicts[id] ? b.verdict[verdicts[id]!] : b.notMeasuredCell}</td>)}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )
    }
  </article>
</Base>

<style>
  h1 {
    font-size: clamp(30px, 5vw, 52px);
    font-weight: 800;
    letter-spacing: -0.04em;
  }
  .intro {
    margin: 18px 0 12px;
    max-width: 46em;
    font-size: 17px;
    line-height: 1.55;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 24px;
    margin: 0 0 8px;
    font-size: 15px;
  }
  section {
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--rule);
  }
  h2 {
    font-size: 21px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  h3 {
    font-size: 14px;
    font-weight: 700;
    margin: 28px 0 10px;
  }
  .caption {
    margin: 10px 0 4px;
    max-width: 46em;
  }
  .meta,
  .note {
    font-size: 14px;
    color: var(--muted);
    margin: 0 0 20px;
  }
  .note {
    margin-top: 8px;
  }
  .meta a {
    color: var(--ink);
    margin-left: 4px;
  }
  pre {
    margin: 0;
    padding: 14px 16px;
    border: 1px solid var(--rule);
    border-radius: 3px;
    background: var(--paper-2);
    color: var(--ink);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    line-height: 1.6;
  }
  .scroll {
    overflow-x: auto;
  }
  .lessons {
    border-collapse: separate;
    border-spacing: 0;
    font-size: 14px;
  }
  .lessons th,
  .lessons td {
    text-align: left;
    padding: 8px 16px 8px 0;
    border-top: 1px solid var(--rule);
    vertical-align: top;
  }
  .lessons thead th {
    border-top: 0;
    color: var(--muted);
    font-weight: 600;
    white-space: nowrap;
  }
  .lessons thead a {
    color: inherit;
  }
  .lessons td {
    white-space: nowrap;
  }
  .lessons tbody th {
    font-weight: 500;
    min-width: 18em;
    max-width: 40em;
  }
  .lessons .first {
    position: sticky;
    left: 0;
    background: var(--paper);
  }
  @media (max-width: 640px) {
    .lessons tbody th {
      min-width: 13em;
    }
  }
</style>
