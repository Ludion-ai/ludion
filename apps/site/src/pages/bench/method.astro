---
// How FreshBench measures: docs/bench/README.md, rendered at build time, then what each run cost, summed from the
// run's own files. The README's links are absolute, so they work both on GitHub and here.
import Base from "../../layouts/Base.astro";
import { Content as Readme } from "../../../../../docs/bench/README.md";
import { siteData } from "../../build/data.ts";
import { en } from "../../strings/en.ts";

const { done3 } = await siteData();
const m = en.bench.methodPage;
const runs = done3?.runs ?? [];
---

<Base title={m.title} description={en.bench.intro}>
  <article class="wrap">
    <p class="up"><a href="/bench/">{en.bench.heading}</a></p>
    <div class="readme"><Readme /></div>
    <p class="meta">{m.source}</p>

    {
      done3 && runs.length > 0 && (
        <section aria-labelledby="cost">
          <h2 id="cost">{m.cost}</h2>
          <p class="meta">{m.costCaption}</p>
          <div class="scroll" role="region" aria-labelledby="cost" tabindex="0">
            <table>
              <thead>
                <tr>
                  <th scope="col">{m.run}</th>
                  <th scope="col" class="num">{m.answering}</th>
                  <th scope="col" class="num">{m.judging}</th>
                  <th scope="col" class="num">{m.total}</th>
                </tr>
              </thead>
              <tbody>
                {runs.map((r) => (
                  <tr>
                    <th scope="row">
                      <code>{done3.dir}/{r.label}</code>
                    </th>
                    <td class="num">{m.usd(r.answerUsd)}</td>
                    <td class="num">{m.usd(r.judgeUsd)}</td>
                    <td class="num">{m.usd(r.answerUsd + r.judgeUsd)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )
    }
  </article>
</Base>

<style>
  article {
    max-width: 52em;
  }
  .up {
    margin: 0 0 24px;
    font-size: var(--font-small);
    color: var(--muted);
  }
  .up a {
    color: inherit;
    text-decoration: none;
  }
  .up a:hover {
    color: var(--ink);
    text-decoration: underline;
  }
  .readme {
    font-size: var(--font-body);
    line-height: 1.75;
    overflow-wrap: anywhere;
  }
  .readme :global(h1) {
    font-size: var(--font-title);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.04em;
    margin-bottom: 24px;
  }
  .readme :global(h2),
  section h2 {
    font-size: 24px;
    font-weight: 550;
    line-height: 1.25;
    letter-spacing: -0.025em;
    margin: 48px 0 16px;
    padding-top: 24px;
    border-top: 1px solid var(--rule);
  }
  .readme :global(li) {
    margin: 0 0 14px;
  }
  .readme :global(ul) {
    padding-left: 1.25em;
  }
  .readme :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }
  .readme :global(code) {
    font-size: 13px;
  }
  .meta {
    font-size: var(--font-small);
    line-height: 1.65;
    color: var(--muted);
  }
  table {
    border-collapse: collapse;
    font-size: 14px;
  }
  th,
  td {
    text-align: left;
    padding: 12px 24px 12px 0;
    border-top: 1px solid var(--rule);
  }
  thead th {
    border-top: 0;
    color: var(--muted);
    font-weight: 600;
  }
  tbody th {
    font-weight: 500;
  }
  .num {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .scroll {
    overflow-x: auto;
  }
</style>
