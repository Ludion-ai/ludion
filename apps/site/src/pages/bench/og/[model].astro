---
// The share card's source: one model's knowledge strip and its count, nothing else, laid out at 1200×630.
// scripts/og.ts screenshots it after the build into /bench/og/<model>.png, which /bench/<model>/ names as og:image.
import "../../../styles/global.css";
import KnowledgeStrip from "../../../components/KnowledgeStrip.astro";
import Wordmark from "../../../components/Wordmark.astro";
import { benchModels } from "../../../build/bench.ts";
import { knowledge } from "../../../build/knowledge.ts";
import { siteData } from "../../../build/data.ts";
import { en, formatDate } from "../../../strings/en.ts";

export async function getStaticPaths() {
  const { done3, models } = await siteData();
  return benchModels(done3, models).map((m) => ({ params: { model: m.id }, props: { name: m.name } }));
}

const { model } = Astro.params as { model: string };
const { name } = Astro.props as { name: string };
const { models, index, config, releaseDates } = await siteData();
const b = en.bench;
const k = knowledge(index, models, releaseDates);
const strip = k.strips.find((s) => s.model === model);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=1200" />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(`/bench/og/${model}/`, config.site).href} />
    <meta name="color-scheme" content="light" />
    <title>{b.card.title(name)}</title>
  </head>
  <body>
    <div class="card">
      <header>
        <Wordmark height={34} />
        <span class="where">ludion.ai/bench</span>
      </header>
      <h1>{name}</h1>
      {strip ? <KnowledgeStrip strip={strip} lessons={k.lessons} link={false} size="card" /> : <p class="none">{b.notMeasured}</p>}
      {
        k.measuredAt && (
          <p class="date">
            {b.knowledge.cardNote(strip?.notMeasured ?? 0)} {b.measured(formatDate(k.measuredAt))}.
          </p>
        )
      }
    </div>
  </body>
</html>

<style>
  body {
    min-height: 0;
  }
  .card {
    width: 1200px;
    height: 630px;
    overflow: hidden;
    padding: 44px 56px 0;
    background: var(--paper);
    display: flex;
    flex-direction: column;
  }
  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 22px;
  }
  .where {
    font-size: 22px;
    font-weight: 600;
    color: var(--muted);
  }
  h1 {
    font-size: 40px;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 6px;
  }
  .none {
    font-size: 30px;
    color: var(--muted);
  }
  .date {
    margin: auto 0 34px;
    font-size: 19px;
    color: var(--muted);
  }
</style>
