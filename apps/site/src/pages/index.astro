---
// First visit: what the lessons are for, how to start, and one real verified lesson.
// The water continues to the page top, with the existing lower fade preserved.
import Base from "../layouts/Base.astro";
import Claim from "../components/Claim.astro";
import LessonCard from "../components/LessonCard.astro";
import StatusChip from "../components/StatusChip.astro";
import SubjectTag from "../components/SubjectTag.astro";
import RecordedComparison from "../components/RecordedComparison.astro";
import { claimParts } from "../build/claim-parts.ts";
import { homeComparison } from "../build/home.ts";
import { siteData } from "../build/data.ts";
import { en, formatDate } from "../strings/en.ts";

const { index, teacherHref, done3 } = await siteData();
const hasComparison = homeComparison(done3) !== null;
const [newest, ...rest] = index.lessons;
const recent = rest.slice(0, 3);
const parts = newest ? claimParts(newest.claim) : null;
---

<Base title={en.home.title} description={en.home.sub}>
  <section class:list={["hero", "wrap", { "single": !hasComparison }]}>
    <div class="intro">
    <h1>{en.home.headline}</h1>
    <p class="sub">{en.home.sub}</p>
    <div class="actions">
      <a class="start" href="/start/">{en.home.start}<span aria-hidden="true"> →</span></a>
      <code>npx ludion-ai sync</code>
    </div>
    <p class="coverage"><a href="/lessons/">{en.home.coverage}</a></p>
    </div>
    <RecordedComparison />
  </section>

  {
    newest && parts && (
      <section class="replay wrap" aria-labelledby="replay" data-water data-water-at="0.6">
        <div class="grid" data-water-surface>
          <article class="example">
            <h2 id="replay">{en.home.example}</h2>
            <a class="claim text" href={`/lessons/${newest.id}/`}>
              <span class="head"><Claim text={parts.head} /></span>
              {parts.detail && <span class="detail">{" "}<Claim text={parts.detail} /></span>}
              {parts.tail && <span class="tail"> {parts.tail.text}</span>}
            </a>
            <p class="evidence"><a href={`/lessons/${newest.id}/#evidence`}>{en.home.readEvidence}<span aria-hidden="true"> →</span></a></p>
          </article>
          <div class="record">
            <p class="state" data-water-hit>
              <StatusChip status="verified" label={en.lesson.verifiedBy[newest.verified_by]} by={newest.verified_by} />
            </p>
            <p class="applies"><SubjectTag subject={newest.subject} version={newest.version} /></p>
            <p class="sign">
              <span class="by">{en.lesson.taughtBy}{" "}{teacherHref(newest.teacher_id) ? <a href={teacherHref(newest.teacher_id)!}>@{newest.teacher}</a> : <span>@{newest.teacher}</span>}{newest.drafted_by === "agent" && <span class="drafted">{en.lesson.drafted}</span>}</span>
            </p>
            <time datetime={newest.verified_at}>{formatDate(newest.verified_at)}</time>
          </div>
        </div>
      </section>
    )
  }

  {
    recent.length > 0 && (
      <section class="recent wrap" aria-labelledby="recent">
        <h2 id="recent">{en.home.recent}</h2>
        <ul class="list">
          {recent.map((l) => (
            <li>
              <LessonCard
                id={l.id}
                claim={l.claim}
                subject={l.subject}
                version={l.version}
                kind={(l as { kind?: string }).kind}
                teacher={l.teacher}
                teacherId={l.teacher_id}
                teacherHref={teacherHref(l.teacher_id)}
                verifiedBy={l.verified_by}
                verifiedAt={l.verified_at}
                drafted={l.drafted_by === "agent"}
              />
            </li>
          ))}
        </ul>
        <p class="all"><a href="/lessons/">{en.home.seeLessons}<span aria-hidden="true"> →</span></a></p>
      </section>
    )
  }
</Base>

<style>
  .hero {
    display:grid;
    grid-template-columns:minmax(0,0.9fr) minmax(0,1.1fr);
    gap:72px;
    align-items:center;
    padding-block:40px 88px;
  }
  .hero.single { grid-template-columns:minmax(0,1fr); }
  h1 {
    font-weight: 600;
    font-size: clamp(40px, 4.6vw, 60px);
    max-width:13ch;
    line-height: 1.06;
    letter-spacing: -0.04em;
  }
  .sub {
    margin: 22px 0 0;
    max-width: 34em;
    font-size: 18px;
    line-height: 1.55;
    font-weight: 400;
    color: var(--text);
  }
  .actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 18px 28px;
    margin-top: 32px;
  }
  .start {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    gap: 6px;
    padding: 10px 16px;
    background: var(--ink);
    color: var(--paper);
    border-radius: 3px;
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
  }
  .start:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .actions code {
    color: var(--muted);
    overflow-wrap: anywhere;
  }
  .coverage { margin:18px 0 0; font-size:13px; color:var(--muted); }
  .coverage a {color:inherit;}
  .replay {
    padding-block: 0;
  }
  .grid {
    padding-top: 80px;
    border-top: 2px solid var(--rule-strong);
    display: grid;
    grid-template-columns: minmax(0, 1fr) 18rem;
    gap: 32px 80px;
    align-items: start;
  }
  .example h2,
  .recent h2 {
    margin: 0 0 20px;
    font-size: 13px;
    font-weight: 500;
    color: var(--muted);
  }
  .text {
    display: block;
    max-width: 44em;
    overflow-wrap: anywhere;
    text-decoration: none;
  }
  .head {
    display: block;
    font-size: 24px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }
  .detail {
    display: block;
    margin-top: 14px;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.65;
    letter-spacing: 0;
    color: var(--text);
  }
  .tail {
    display: block;
    margin-top: 12px;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.55;
    letter-spacing: 0;
    color: var(--muted);
  }
  .text:hover .head {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .evidence {
    margin: 20px 0 0;
    font-size: 14px;
  }
  .record {
    padding-top: 35px;
    font-size: 13px;
    line-height: 1.65;
    color: var(--muted);
  }
  .record p {
    margin: 0 0 14px;
  }
  .by {
    overflow-wrap: anywhere;
  }
  .by a {
    color: var(--ink);
  }
  .recent {
    padding-top: 88px;
  }
  .all {
    margin: 0;
    padding-top: 22px;
    border-top: 1px solid var(--rule);
    font-size: 15px;
    font-weight: 500;
  }
  @media (max-width: 900px) {
    .hero {grid-template-columns:minmax(0,1fr);gap:48px;}
    h1 {max-width:20ch;}
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .record {
      padding-top: 0;
    }
  }
  @media (max-width: 640px) {
    .hero {
      padding-block: 16px 64px;
    }
    .sub {
      font-size: 17px;
    }
    .head {
      font-size: 21px;
      overflow-wrap: anywhere;
    }
    .grid {
      padding-top: 64px;
      gap: 24px;
    }
    .recent {
      padding-top: 64px;
    }
  }
</style>
