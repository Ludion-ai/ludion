---
// Home is one brand scene. Setup, lessons and recorded evidence have their own pages.
import Base from "../layouts/Base.astro";
import LudionSurface from "../components/LudionSurface.astro";
import { en } from "../strings/en.ts";
---

<Base title={en.home.title} description={en.site.description}>
  <section class="home-stage" aria-labelledby="home-heading" data-water data-water-showcase>
    <div class="introduction wrap">
      <h1 id="home-heading">{en.home.headline}</h1>
      <p>{en.home.sub}</p>
    </div>
    <div class="scene">
      <span class="horizon" data-water-surface aria-hidden="true"></span>
      <LudionSurface />
    </div>
    <div class="invitation wrap">
      <div class="actions">
        <a class="start" href="/start/">{en.home.start}<span aria-hidden="true"> ↗</span></a>
        <a class="proof" id="replay" href="/bench/#recorded-answer">{en.home.seeItWork}<span aria-hidden="true"> →</span></a>
      </div>
      <p class="coverage" id="recent"><a href="/lessons/">{en.home.coverage}</a></p>
    </div>
  </section>
</Base>

<style>
  .home-stage {
    flex: 1;
    display: grid;
    grid-template-rows: auto minmax(250px, 1fr) auto;
    min-height: calc(100svh - 152px);
    padding-block: 56px 36px;
    text-align: center;
  }
  .introduction { position: relative; z-index: 2; }
  h1 {
    font-size: clamp(30px, 3.5vw, 44px);
    font-weight: 430;
    line-height: 1.15;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .introduction p { margin: 15px 0 0; color: var(--muted); font-size: 15px; }
  .scene {
    position: relative;
    width: min(100%, 920px);
    min-width: 0;
    align-self: center;
    justify-self: center;
    margin-block: 16px 24px;
  }
  .horizon { position: absolute; top: 56%; left: 0; width: 100%; height: 0; }
  .actions { display: flex; justify-content: center; align-items: center; flex-wrap: wrap; gap: 18px 28px; }
  .start {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    min-height: 44px;
    padding: 10px 21px;
    border: 1px solid var(--ink);
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    transition: transform 180ms, opacity 180ms;
  }
  .start:hover { opacity: 0.84; transform: translateY(-2px); }
  .proof { padding: 10px 0; font-size: 14px; text-decoration: none; }
  .proof:hover { text-decoration: underline; }
  .coverage { margin: 17px 0 0; font-size: 12px; color: var(--muted); }
  .coverage a { color: inherit; text-decoration-color: var(--rule); }
  @media (max-width: 640px) {
    .home-stage { min-height: calc(100svh - 180px); padding-block: 48px 32px; grid-template-rows: auto minmax(240px, 1fr) auto; }
    h1 { max-width: 19ch; margin-inline: auto; }
    .introduction p { max-width: 24ch; margin-inline: auto; font-size: 14px; }
    .scene { margin-block: 20px; }
    .actions { gap: 20px; }
  }
</style>
