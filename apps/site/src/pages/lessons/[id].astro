---
import LessonView from "../../components/LessonView.astro";
import TombstoneView from "../../components/TombstoneView.astro";
import { siteData, type LessonPage, type Tombstone } from "../../build/data.ts";

// Every lesson on main (replaced ones included), and a tombstone for every retracted one, so links keep working.
export async function getStaticPaths() {
  const { pages, tombstones } = await siteData();
  return [
    ...pages.map((page) => ({ params: { id: page.lesson.id }, props: { page } })),
    ...tombstones.map((tombstone) => ({ params: { id: tombstone.id }, props: { tombstone } })),
  ];
}

const { page, tombstone } = Astro.props as { page?: LessonPage; tombstone?: Tombstone };
---

{page ? <LessonView page={page} /> : <TombstoneView tombstone={tombstone!} />}
