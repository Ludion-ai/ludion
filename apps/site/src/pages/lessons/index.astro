---
// Every active lesson, grouped by subject (the largest first), newest first within each, the subject's name held on
// the left as its lessons scroll by. Above it, a tile per subject (its count and its newest day) and how the lessons
// were verified, all counted from index.json; then a search box and filters (a few lines of JavaScript; without it
// every lesson shows).
import Base from "../../layouts/Base.astro";
import Pool from "../../components/Pool.astro";
import LessonCard from "../../components/LessonCard.astro";
import Mark from "../../components/Mark.astro";
import { claimParts } from "../../build/claim-parts.ts";
import { siteData } from "../../build/data.ts";
import { en, formatDate } from "../../strings/en.ts";
import type { Index } from "@ludion/core";

const STATIC_LIMIT = 100;
const { index, teacherHref } = await siteData();
type Entry = Index["lessons"][number] & { kind?: string; signal?: string };
const shown = (index.lessons as Entry[]).slice(0, STATIC_LIMIT);
const L = en.lessons;
const subjects = [...new Set(shown.map((l) => l.subject))]
  .map((s) => {
    const ls = shown.filter((l) => l.subject === s);
    return { subject: s, count: ls.length, newest: ls.map((l) => l.verified_at).sort().at(-1)! };
  })
  .sort((a, b) => b.count - a.count || a.subject.localeCompare(b.subject));
const kinds = [...new Set(shown.map((l) => l.kind).filter((k): k is string => !!k))].sort();
const byHow = [...new Set(shown.map((l) => l.verified_by))].map((how) => ({ how, count: shown.filter((l) => l.verified_by === how).length })).sort((a, b) => b.count - a.count);
const groups = subjects.map((s) => ({ ...s, lessons: shown.filter((l) => l.subject === s.subject) }));
const silent = (l: Entry) => claimParts(l.claim).tail?.kind === "silent";
const max = Math.max(1, ...subjects.map((s) => s.count));
---

<Base title={`${L.title} | Ludion`} description={L.description}>
  <div class="wrap">
    <header class="hero">
      <h1>{L.title}</h1>
      <p class="sub">{index.lessons.length ? L.intro(shown.length, index.lessons.length) : L.empty}</p>
      {
        subjects.length > 0 && (
          <Pool class="tiles-pool" at={0.5}>
          <ul class="tiles">
            {subjects.map((s) => (
              <li>
                <a href={`/${s.subject}/`}>
                  <span class="subj">{s.subject}/</span>
                  <span class="num">{s.count}</span>
                  <span class="fill" aria-hidden="true">
                    <i style={`width:${Math.round((s.count / max) * 1000) / 10}%`} />
                  </span>
                  <span class="newest">{L.newest(formatDate(s.newest))}</span>
                </a>
              </li>
            ))}
          </ul>
          </Pool>
        )
      }
      {byHow.length > 0 && (
        <p class="how">
          {byHow.map((h) => (
            <span>
              <b>{h.count}</b> {en.lesson.verifiedBy[h.how as keyof typeof en.lesson.verifiedBy].toLowerCase()}
            </span>
          ))}
        </p>
      )}
    </header>

    {
      shown.length > 0 && (
        <section class="all" aria-labelledby="all">
          <h2 id="all" class="visually-hidden">{L.title}</h2>
          <div class="tools" hidden>
            <label class="search">
              <span class="visually-hidden">{L.search}</span>
              <input type="search" name="q" placeholder={L.searchPlaceholder} autocomplete="off" />
            </label>
            <fieldset>
              <legend class="visually-hidden">{en.bench.list.subject}</legend>
              <label class="pill"><input type="radio" name="subject" value="" checked />{en.bench.list.all}</label>
              {subjects.map((s) => <label class="pill"><input type="radio" name="subject" value={s.subject} />{s.subject}/</label>)}
            </fieldset>
            <fieldset>
              <legend class="visually-hidden">{en.bench.list.kind}</legend>
              <label class="pill"><input type="radio" name="kind" value="" checked />{en.bench.list.anyKind}</label>
              {kinds.map((k) => <label class="pill"><input type="radio" name="kind" value={k} />{en.bench.kind[k] ?? k}</label>)}
            </fieldset>
            <fieldset>
              <legend class="visually-hidden">{en.bench.list.silent}</legend>
              <label class="pill"><input type="checkbox" name="silent" /><Mark kind="silent" label /></label>
            </fieldset>
            <p class="showing" aria-live="polite" data-count>{en.bench.list.showing(shown.length, shown.length)}</p>
          </div>

          <ol class="groups">
            {groups.map((g) => (
              <li class="group" data-group id={`s-${g.subject}`}>
                <h3 class="gname">
                  <a href={`/${g.subject}/`} class="gsubj">{g.subject}/</a>
                  <span class="n">{L.count(g.count)}</span>
                </h3>
                <ul class="list">
                  {g.lessons.map((l) => (
                    <li data-subject={l.subject} data-kind={l.kind ?? ""} data-silent={silent(l) ? "1" : ""} data-text={`${l.claim} ${l.subject}`.toLowerCase()}>
                      <LessonCard
                        id={l.id}
                        claim={l.claim}
                        subject={l.subject}
                        version={l.version}
                        kind={l.kind}
                        teacher={l.teacher}
                        teacherId={l.teacher_id}
                        teacherHref={teacherHref(l.teacher_id)}
                        verifiedBy={l.verified_by}
                        verifiedAt={l.verified_at}
                        drafted={l.drafted_by === "agent"}
                        hideSubject
                      />
                    </li>
                  ))}
                </ul>
              </li>
            ))}
          </ol>
          <p class="none" hidden data-none>{L.noMatch}</p>
        </section>
      )
    }
  </div>
</Base>

<script>
  import { en } from "../../strings/en.ts";
  const tools = document.querySelector<HTMLElement>(".tools");
  if (tools) {
    const rows = [...document.querySelectorAll<HTMLElement>(".groups li[data-subject]")];
    const groups = [...document.querySelectorAll<HTMLElement>(".groups [data-group]")];
    const count = tools.querySelector<HTMLElement>("[data-count]")!;
    const none = document.querySelector<HTMLElement>("[data-none]")!;
    const q = tools.querySelector<HTMLInputElement>('input[name="q"]')!;
    const pick = (name: string) => tools.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`)?.value ?? "";
    const apply = () => {
      const words = q.value.toLowerCase().split(/\s+/).filter(Boolean);
      const subject = pick("subject");
      const kind = pick("kind");
      const silent = tools.querySelector<HTMLInputElement>('input[name="silent"]')!.checked;
      let shown = 0;
      for (const row of rows) {
        const on =
          (!subject || row.dataset.subject === subject) &&
          (!kind || row.dataset.kind === kind) &&
          (!silent || row.dataset.silent === "1") &&
          words.every((w) => row.dataset.text!.includes(w));
        row.hidden = !on;
        if (on) shown++;
      }
      for (const g of groups) g.hidden = !g.querySelector("li[data-subject]:not([hidden])");
      count.textContent = en.bench.list.showing(shown, rows.length);
      none.hidden = shown > 0;
    };
    tools.addEventListener("input", apply);
    tools.addEventListener("change", apply);
    tools.hidden = false;
  }
</script>

<style>
  h1 {
    font-weight: 820;
    font-size: clamp(48px, 8vw, 104px);
    line-height: 0.92;
    letter-spacing: -0.055em;
  }
  .sub {
    margin: 18px 0 0;
    font-size: clamp(17px, 1.9vw, 20px);
    color: var(--text);
  }
  /* A tile per subject: its name, its count, its share of the largest, its newest day. */
  :global(.tiles-pool) {
    margin-top: 44px;
  }
  .tiles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
  }
  .tiles li {
    border-bottom: 1px solid var(--rule);
  }
  .tiles a {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas: "subj num" "fill fill" "newest newest";
    gap: 8px 12px;
    padding: 18px 24px 18px 0;
    color: inherit;
    text-decoration: none;
  }
  .tiles a:hover .subj {
    text-decoration: underline;
  }
  .subj {
    grid-area: subj;
    align-self: end;
    font-family: var(--font-code);
    font-variant-ligatures: none;
    font-size: 17px;
    font-weight: 700;
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  .num {
    grid-area: num;
    font-size: 40px;
    font-weight: 820;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .fill {
    grid-area: fill;
    display: block;
    height: 4px;
    background: var(--paper-2);
  }
  .fill i {
    display: block;
    height: 100%;
    background: var(--ink);
  }
  .newest {
    grid-area: newest;
    font-size: 12px;
    color: var(--muted);
  }
  .how {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 22px;
    margin: 16px 0 0;
    font-size: 14px;
    color: var(--muted);
  }
  .how b {
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .all {
    margin-top: 56px;
  }
  .tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 16px;
    padding: 14px 0;
    margin-bottom: 8px;
    border-top: 2px solid var(--rule-strong);
    border-bottom: 1px solid var(--rule);
  }
  .tools[hidden] {
    display: none;
  }
  .search {
    flex: 1 1 16rem;
  }
  .search input {
    width: 100%;
    box-sizing: border-box;
    font: inherit;
    font-size: 15px;
    padding: 9px 14px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--paper);
    color: var(--ink);
  }
  .search input:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 1px;
  }
  fieldset {
    display: flex;
    gap: 2px;
    margin: 0;
    padding: 3px;
    min-width: 0;
    max-width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
    border: 1px solid var(--rule);
    border-radius: 999px;
  }
  .pill {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    border-radius: 999px;
    font-family: var(--font-code);
    font-variant-ligatures: none;
    font-size: 13px;
    color: var(--muted);
    white-space: nowrap;
    cursor: pointer;
  }
  .pill input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  .pill:has(input:checked) {
    background: var(--ink);
    color: var(--paper);
  }
  .pill:has(input:checked) :global(.mark),
  .pill:has(input:checked) :global(.words) {
    color: var(--paper);
  }
  .pill:has(input:focus-visible) {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
  .showing {
    margin: 0 0 0 auto;
    font-size: 13px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  /* The groups: the subject's name on the left, held while its lessons scroll by. */
  .groups {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .group {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: 0 32px;
    padding-top: 28px;
  }
  .group[hidden] {
    display: none;
  }
  .gname {
    margin: 0;
    padding-top: 24px;
    align-self: start;
    position: sticky;
    top: 24px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .gsubj {
    font-family: var(--font-code);
    font-variant-ligatures: none;
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--ink);
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  a.gsubj:hover {
    text-decoration: underline;
  }
  .gname .n {
    font-family: var(--font-code);
    font-variant-ligatures: none;
    font-size: 12px;
    font-weight: 400;
    color: var(--muted);
  }
  .gname .n {
    margin-top: 8px;
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .list li[hidden] {
    display: none;
  }
  .none {
    margin: 32px 0;
    color: var(--muted);
  }
  @media (max-width: 760px) {
    .group {
      grid-template-columns: minmax(0, 1fr);
    }
    .gname {
      position: static;
      flex-direction: row;
      align-items: baseline;
      gap: 12px;
      padding: 8px 0 4px;
      border-bottom: 2px solid var(--rule-strong);
    }
    .gname .n {
      margin: 0 0 0 auto;
    }
    .showing {
      margin-left: 0;
    }
  }
</style>
