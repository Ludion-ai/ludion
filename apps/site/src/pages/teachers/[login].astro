---
import Pool from "../../components/Pool.astro";
import Base from "../../layouts/Base.astro";
import LessonCard from "../../components/LessonCard.astro";
import { siteData } from "../../build/data.ts";
import { en } from "../../strings/en.ts";

// One page per teacher id, at the current login lowercased. Served at /@<login> by the Worker.
export async function getStaticPaths() {
  const { teacherPages } = await siteData();
  return [...teacherPages].map(([login, id]) => ({ params: { login }, props: { id } }));
}

const { id } = Astro.props as { id: number };
const { index, loginOf, teacherHref, avatarOf } = await siteData();
const login = loginOf(id);
const summary = index.teachers[String(id)]!;
const lessons = index.lessons.filter((l) => l.teacher_id === id);
---

<Base title={en.teacher.title(login)} canonicalPath={`/@${login.toLowerCase()}`}>
  <div class="wrap">
    <p class="back"><a href="/lessons/">← {en.nav.lessons}</a></p>
    <header class="teacher">
      <img src={avatarOf(id, 64)} alt="" width="56" height="56" />
      <div>
        <h1>@{login}</h1>
        <p class="summary">
          <span>{en.teacher.summary(summary.lessons, summary.subjects.length)}</span>
          <a href={`https://github.com/${login}`}>{en.teacher.profile}</a>
        </p>
      </div>
    </header>
    <Pool>
    <ul class="list">
      {
        lessons.map((l) => (
          <li>
            <LessonCard
              id={l.id}
              claim={l.claim}
              subject={l.subject}
              version={l.version}
              kind={(l as { kind?: string }).kind}
              teacher={l.teacher}
              teacherId={l.teacher_id}
              teacherHref={teacherHref(l.teacher_id)}
              verifiedBy={l.verified_by}
              verifiedAt={l.verified_at}
              drafted={l.drafted_by === "agent"}
              hideTeacher
            />
          </li>
        ))
      }
    </ul>
    </Pool>
  </div>
</Base>

<style>
  .back {
    margin: 0 0 24px;
    font-size: var(--font-small);
    color: var(--muted);
  }
  .back a {
    color: inherit;
    text-decoration: none;
  }
  .back a:hover {
    color: var(--ink);
    text-decoration: underline;
  }
  .teacher {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-bottom: 40px;
  }
  .teacher img {
    border-radius: 8px;
    flex: none;
    border: 1px solid var(--rule);
  }
  .teacher > div {
    min-width: 0;
  }
  h1 {
    font-weight: 550;
    font-size: clamp(28px, 4vw, 40px);
    line-height: 1.15;
    letter-spacing: -0.03em;
    overflow-wrap: anywhere;
  }
  .summary {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    margin: 10px 0 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--muted);
  }
  .summary a {
    color: inherit;
    text-decoration-color: var(--rule);
  }
  .summary a:hover {
    color: var(--ink);
    text-decoration-color: currentColor;
  }
  @media (max-width: 480px) {
    .teacher {
      align-items: flex-start;
      gap: 14px;
    }
    .teacher img {
      width: 44px;
      height: 44px;
    }
  }
</style>
