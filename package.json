{
  "name": "ludion-repo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "tools/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/worker/tsconfig.json",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vitest-plugin": "^1.3.7",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.148.0"
  },
  "overrides": {
    "miniflare": {
      "undici": "7.30.1"
    }
  }
}
