{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^cap:sha256:[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "const": "capability/1"
        },
        "contract": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"
            },
            "intent": {
              "type": "string",
              "minLength": 10,
              "maxLength": 400
            },
            "pre": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 300
              }
            },
            "post": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "statement": {
                    "type": "string",
                    "maxLength": 300
                  },
                  "verified_by": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "statement",
                  "verified_by"
                ],
                "additionalProperties": false
              }
            },
            "excludes": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 300
              }
            }
          },
          "required": [
            "id",
            "intent",
            "pre",
            "post",
            "excludes"
          ],
          "additionalProperties": false
        },
        "guard": {
          "type": "object",
          "properties": {
            "contract_id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"
            },
            "structure": {
              "minItems": 1,
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "call"
                      },
                      "target": {
                        "type": "object",
                        "properties": {
                          "module": {
                            "type": "string"
                          },
                          "export": {
                            "type": "string"
                          },
                          "member": {
                            "default": [],
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        },
                        "required": [
                          "module",
                          "export",
                          "member"
                        ],
                        "additionalProperties": false
                      },
                      "files": {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200
                        }
                      },
                      "presence": {
                        "type": "string",
                        "enum": [
                          "required",
                          "absent_in_scope"
                        ]
                      },
                      "binding": {
                        "type": "string",
                        "const": "import_resolved"
                      }
                    },
                    "required": [
                      "kind",
                      "target",
                      "files",
                      "presence",
                      "binding"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "config"
                      },
                      "file": {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200
                        }
                      },
                      "key": {
                        "type": "string"
                      },
                      "inapplicable_if": {
                        "anyOf": [
                          {
                            "type": "boolean"
                          },
                          {
                            "type": "string"
                          },
                          {
                            "type": "integer",
                            "minimum": -9007199254740991,
                            "maximum": 9007199254740991
                          }
                        ]
                      }
                    },
                    "required": [
                      "kind",
                      "file",
                      "key",
                      "inapplicable_if"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "packages": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "ecosystem": {
                    "type": "string",
                    "const": "npm"
                  },
                  "name": {
                    "type": "string"
                  },
                  "applicable_versions": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^\\d+\\.\\d+\\.\\d+$"
                    }
                  },
                  "inapplicable_versions": {
                    "default": [],
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^\\d+\\.\\d+\\.\\d+$"
                    }
                  }
                },
                "required": [
                  "ecosystem",
                  "name",
                  "applicable_versions",
                  "inapplicable_versions"
                ],
                "additionalProperties": false
              }
            },
            "runtime": {
              "type": "object",
              "properties": {
                "node_major": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^\\d+$"
                  }
                }
              },
              "required": [
                "node_major"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "contract_id",
            "structure",
            "packages",
            "runtime"
          ],
          "additionalProperties": false
        },
        "program": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "codemod.ts-ast"
            },
            "entry": {
              "type": "string",
              "minLength": 1,
              "maxLength": 260
            },
            "files": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1,
                "maxLength": 260
              },
              "additionalProperties": {
                "type": "string"
              }
            },
            "effects": {
              "type": "object",
              "properties": {
                "writes": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "network": {
                  "type": "boolean",
                  "const": false
                },
                "env": {
                  "maxItems": 0,
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "spawn": {
                  "type": "boolean",
                  "const": false
                }
              },
              "required": [
                "writes",
                "network",
                "env",
                "spawn"
              ],
              "additionalProperties": false
            },
            "timeout_ms": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 120000
            }
          },
          "required": [
            "kind",
            "entry",
            "files",
            "effects",
            "timeout_ms"
          ],
          "additionalProperties": false
        },
        "verifier": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "vitest-run"
            },
            "files": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1,
                "maxLength": 260
              },
              "additionalProperties": {
                "type": "string"
              }
            },
            "mount_at": {
              "type": "string",
              "minLength": 1,
              "maxLength": 260
            },
            "argv": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "required_tests": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "run_recipient_tests": {
              "type": "boolean"
            },
            "protected_paths": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "allow_skip": {
              "type": "boolean",
              "const": false
            },
            "timeout_ms": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 300000
            }
          },
          "required": [
            "kind",
            "files",
            "mount_at",
            "argv",
            "required_tests",
            "run_recipient_tests",
            "protected_paths",
            "allow_skip",
            "timeout_ms"
          ],
          "additionalProperties": false
        },
        "dependencies": {
          "type": "object",
          "properties": {
            "capabilities": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^cap:sha256:[0-9a-f]{64}$"
              }
            },
            "image": {
              "type": "string"
            }
          },
          "required": [
            "capabilities",
            "image"
          ],
          "additionalProperties": false
        },
        "invalidates_on": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "program_changed",
              "verifier_changed",
              "dependency_changed",
              "counterexample_added",
              "lockfile_changed",
              "source_changed",
              "runtime_changed"
            ]
          }
        }
      },
      "required": [
        "format",
        "contract",
        "guard",
        "program",
        "verifier",
        "dependencies",
        "invalidates_on"
      ],
      "additionalProperties": false
    },
    "lineage": {
      "type": "object",
      "properties": {
        "derived_from": {
          "minItems": 1,
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "lesson"
                  },
                  "id": {
                    "type": "string",
                    "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                  }
                },
                "required": [
                  "kind",
                  "id"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "trace"
                  },
                  "hash": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "synthetic": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "kind",
                  "hash",
                  "synthetic"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "capability"
                  },
                  "id": {
                    "type": "string",
                    "pattern": "^cap:sha256:[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "kind",
                  "id"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "compiler": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "model": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "name",
            "version",
            "model"
          ],
          "additionalProperties": false
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        }
      },
      "required": [
        "derived_from",
        "compiler",
        "created_at"
      ],
      "additionalProperties": false
    },
    "counterexamples": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "near_miss",
              "false_apply",
              "verifier_gap"
            ]
          },
          "description": {
            "type": "string",
            "maxLength": 400
          },
          "fixture": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "maxLength": 260
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "expected": {
            "type": "string",
            "enum": [
              "inapplicable",
              "unknown",
              "verifier_rejects"
            ]
          },
          "found_by_receipt": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "found_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "id",
          "kind",
          "description",
          "fixture",
          "expected",
          "found_by_receipt",
          "found_at"
        ],
        "additionalProperties": false
      }
    },
    "receipts": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "receipt_id": {
            "type": "string",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
          },
          "hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "recipient": {
            "type": "string"
          }
        },
        "required": [
          "receipt_id",
          "hash",
          "recipient"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "artifact",
    "lineage",
    "counterexamples",
    "receipts"
  ],
  "additionalProperties": false
}
