    "correct": [
      {
        "src/index.js": "import { Agent, routeAgentRequest } from 'agents';\nimport { ChannelGateway } from 'agents/experimental/channels';\nimport { slack } from 'agents/experimental/channels/slack';\n\nexport class Chat extends Agent {\n  async onMessage(connection, message) {\n    connection.send(`echo: ${message}`);\n  }\n  receive(event, origin) {\n    return this.channels.receive(event, origin);\n  }\n}\n\nexport default {\n  async fetch(request, env) {\n    const gateway = new ChannelGateway({\n      agent: (route) => env.Chat.getByName(route),\n      channels: {\n        slack: slack({\n          botToken: env.SLACK_BOT_TOKEN,\n          webhook: { signingSecret: env.SLACK_SIGNING_SECRET, path: '/webhooks/slack' },\n          participant: (event) => event.actor?.id ?? null,\n        }),\n      },\n    });\n    return (await gateway.fetch(request)) ?? (await routeAgentRequest(request, env)) ?? new Response('Not found', { status: 404 });\n  },\n};\n"
      },
      {
        "src/slack.js": "import { slack } from \"agents/experimental/channels/slack\";\n\nexport function slackChannel(env) {\n  return slack({ botToken: env.SLACK_BOT_TOKEN, webhook: { signingSecret: env.SLACK_SIGNING_SECRET } });\n}\n",
        "src/index.js": "import { Agent, routeAgentRequest } from 'agents';\nimport { ChannelGateway } from 'agents/experimental/channels';\nimport { slackChannel } from './slack.js';\n\nexport class Chat extends Agent {}\n\nexport default {\n  async fetch(request, env) {\n    const gateway = new ChannelGateway({ agent: (r) => env.Chat.getByName(r), channels: { slack: slackChannel(env) } });\n    return (await gateway.fetch(request)) ?? (await routeAgentRequest(request, env)) ?? new Response('Not found', { status: 404 });\n  },\n};\n"
      },
