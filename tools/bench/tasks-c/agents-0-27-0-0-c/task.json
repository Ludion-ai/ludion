        "src/channels/slack.js": "import { ChannelGateway } from 'agents/experimental/channels';\nimport { slack } from 'agents/experimental/channels/slack';\nexport const makeGateway = (env) => new ChannelGateway({ agent: (r) => env.Chat.getByName(r), channels: { slack: slack({ botToken: env.SLACK_BOT_TOKEN, webhook: { signingSecret: env.SLACK_SIGNING_SECRET } }) } });\n",
        "src/index.js": "import { Agent, routeAgentRequest } from 'agents';\nimport { makeGateway } from './channels/slack.js';\nexport class Chat extends Agent {}\nexport default {\n  async fetch(request, env) {\n    return (await makeGateway(env).fetch(request)) ?? (await routeAgentRequest(request, env)) ?? new Response('Not found', { status: 404 });\n  },\n};\n"
